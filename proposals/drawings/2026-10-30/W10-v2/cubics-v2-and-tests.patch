+
+#[path = "paper/cubics.rs"]
+mod circular_arc_v2_candidate;
+
+fn v2_arc(center: Vec2, radius: f64, start: f64, sweep: f64) -> Seg2 {
+    Seg2::Arc { center, radius, start, sweep }
+}
+
+fn v2_controls(piece: &Seg2) -> [Vec2; 4] {
+    let Seg2::Cubic { p0, p1, p2, p3 } = *piece else { panic!("not a cubic: {piece:?}") };
+    [p0, p1, p2, p3]
+}
+
+fn v2_check(result: &circular_arc_v2_candidate::ArcCubics, error: f64, cap: usize) {
+    assert!(!result.pieces.is_empty() && result.pieces.len() <= cap);
+    assert!(result.error_bound.is_finite() && result.error_bound >= 0.0 && result.error_bound <= error);
+    for piece in &result.pieces {
+        let [a, b, c, d] = v2_controls(piece);
+        assert!([a, b, c, d].into_iter().all(Vec2::is_finite));
+        assert!(a != d && a != b && c != d);
+    }
+    for pair in result.pieces.windows(2) {
+        let a = pair[0].end();
+        let b = pair[1].start();
+        assert_eq!((a.x.to_bits(), a.y.to_bits()), (b.x.to_bits(), b.y.to_bits()));
+    }
+}
+
+fn v2_near(actual: Vec2, expected: Vec2) {
+    assert!(actual.dist(expected) <= 1e-9, "{actual:?} != {expected:?}");
+}
+
+#[test]
+fn v2_signed_half_turn_has_analytic_controls_and_midpoint() {
+    for sign in [-1.0, 1.0] {
+        let result = circular_arc_v2_candidate::circular_arc(&v2_arc(Vec2::ZERO, 1.0, 0.0, sign * PI), 0.1, 1).unwrap();
+        v2_check(&result, 0.1, 1);
+        let [a, b, c, d] = v2_controls(&result.pieces[0]);
+        for (actual, expected) in [(a, p(1.0, 0.0)), (b, p(1.0, sign * 4.0 / 3.0)), (c, p(-1.0, sign * 4.0 / 3.0)), (d, p(-1.0, 0.0))] {
+            v2_near(actual, expected);
+        }
+        // The standard half-turn cubic interpolates the circular midpoint.
+        v2_near((a + b * 3.0 + c * 3.0 + d) / 8.0, p(0.0, sign));
+    }
+}
+
+#[test]
+fn v2_past_quarter_is_converted_without_clamping_its_endpoint() {
+    // The extra turn is the exact binary fraction1/4096, not a sampled output.
+    let sweep = FRAC_PI_2 + 1.0 / 4096.0;
+    for sign in [-1.0, 1.0] {
+        let result = circular_arc_v2_candidate::circular_arc(&v2_arc(Vec2::ZERO, 1.0, 0.0, sign * sweep), 1e-3, 64).unwrap();
+        v2_check(&result, 1e-3, 64);
+        let end = result.pieces.last().unwrap().end();
+        // sin(delta) is between delta-delta^3/6 and delta: a quarter-clamped x=0 fails.
+        assert!(end.x > -0.000245 && end.x < -0.000243);
+        assert!(end.y * sign > 0.9999999 && end.y * sign < 1.0);
+    }
+}
+
+#[test]
+fn v2_error_and_coordinates_use_the_same_units_without_double_conversion() {
+    let source = v2_arc(p(2.0, -3.0), 1.0, 0.0, FRAC_PI_2);
+    let steps_per_mm = 100_000.0; // Actual10nm grid:1mm=100000steps.
+    let in_steps = v2_arc(p(2.0, -3.0) * steps_per_mm, steps_per_mm, 0.0, FRAC_PI_2);
+    let a = circular_arc_v2_candidate::circular_arc(&source, 9e-5, 64).unwrap();
+    let b = circular_arc_v2_candidate::circular_arc(&in_steps, 9.0, 64).unwrap();
+    v2_check(&a, 9e-5, 64);
+    v2_check(&b, 9.0, 64);
+    assert_eq!(a.pieces.len(), b.pieces.len());
+    for (left, right) in a.pieces.iter().zip(&b.pieces) {
+        for (mm, steps) in v2_controls(left).into_iter().zip(v2_controls(right)) {
+            v2_near(mm, steps / steps_per_mm);
+        }
+    }
+}
+
+#[test]
+fn v2_grid_scale_coordinates_are_not_subject_to_authored_paper_limits() {
+    let arc = v2_arc(p(1_000_000.0, 2_000_000.0), 10_000_000.0, -PI, PI);
+    let result = circular_arc_v2_candidate::circular_arc(&arc, 9.0, 64).unwrap();
+    v2_check(&result, 9.0, 64);
+    assert!(result.pieces.len() > 1);
+}
+
+#[test]
+fn v2_positive_radius_below_the_former_mm_floor_is_not_invalid() {
+    let result = circular_arc_v2_candidate::circular_arc(&v2_arc(Vec2::ZERO, 1e-13, 0.0, FRAC_PI_2), 1e-15, 1).unwrap();
+    v2_check(&result, 1e-15, 1);
+}
+
+#[test]
+fn v2_subnormal_radius_is_positive_but_may_fail_representation_or_certification() {
+    let result = circular_arc_v2_candidate::circular_arc(&v2_arc(Vec2::ZERO, f64::from_bits(1), 0.0, PI), 1e-3, 64);
+    match result {
+        Ok(converted) => v2_check(&converted, 1e-3, 64),
+        Err(error) => {
+            assert!(error.0.contains("enclosure") || error.0.contains("precision") || error.0.contains("certify"), "{error}");
+        }
+    }
+}
+
+#[test]
+fn v2_zero_negative_and_nonfinite_radii_are_invalid() {
+    for radius in [0.0, -0.0, -f64::from_bits(1), -1.0, f64::NAN, f64::INFINITY, f64::NEG_INFINITY] {
+        assert!(circular_arc_v2_candidate::circular_arc(&v2_arc(Vec2::ZERO, radius, 0.0, PI), 1.0, 64).is_err());
+    }
+}
+
+#[test]
+fn v2_overflow_and_precision_collapse_refuse_without_mutation() {
+    for arc in [
+        v2_arc(p(f64::MAX, f64::MAX), f64::MAX, 0.0, FRAC_PI_2),
+        v2_arc(p(1e15, 1e15), 1e-12, 0.5, 1e-12),
+    ] {
+        let before = arc;
+        assert!(circular_arc_v2_candidate::circular_arc(&arc, f64::MAX, 64).is_err());
+        assert_eq!(arc, before);
+    }
+}
+
+#[test]
+fn v2_certificate_does_not_omit_the_analytic_quarter_turn_deviation() {
+    let result = circular_arc_v2_candidate::circular_arc(&v2_arc(Vec2::ZERO, 1.0, 0.0, FRAC_PI_2), 1e-3, 1).unwrap();
+    v2_check(&result, 1e-3, 1);
+    // For the standard tangent/midpoint quarter cubic, z=t(1-t)=1/6
+    // maximizes radial-square error. Closed-form half-angle algebra gives
+    // radial deviation >0.00027; this is an analytic lower bound, not sampling.
+    assert!(result.error_bound > 0.00027);
+    let [a, b, c, d] = v2_controls(&result.pieces[0]);
+    let k = 4.0 * (2.0_f64.sqrt() - 1.0) / 3.0;
+    for (actual, expected) in [(a, p(1.0, 0.0)), (b, p(1.0, k)), (c, p(k, 1.0)), (d, p(0.0, 1.0))] {
+        v2_near(actual, expected);
+    }
+}
+
+#[test]
+fn v2_allowance_and_piece_cap_never_coarsen_or_truncate_a_request() {
+    let arc = v2_arc(Vec2::ZERO, 1.0, 0.0, PI);
+    // One half-turn cubic strays by more than0.018, so1e-4 cannot be certified.
+    assert!(circular_arc_v2_candidate::circular_arc(&arc, 1e-4, 1).is_err());
+    let result = circular_arc_v2_candidate::circular_arc(&arc, 1e-4, 64).unwrap();
+    v2_check(&result, 1e-4, 64);
+    assert!(result.pieces.len() > 1);
+    assert!(circular_arc_v2_candidate::circular_arc(&arc, f64::from_bits(1), 64).is_err());
+}
+
+#[test]
+fn v2_start_and_sweep_domain_is_explicit_without_normalization() {
+    for start in [-PI, PI] {
+        for sweep in [-PI, PI] {
+            let result = circular_arc_v2_candidate::circular_arc(&v2_arc(Vec2::ZERO, 1.0, start, sweep), 0.1, 1).unwrap();
+            v2_check(&result, 0.1, 1);
+            v2_near(result.pieces[0].start(), p(-1.0, 0.0));
+            v2_near(result.pieces[0].end(), p(1.0, 0.0));
+        }
+    }
+    for (start, sweep) in [(PI.next_up(), 0.5), (-PI.next_up(), 0.5), (0.0, PI.next_up()), (0.0, -PI.next_up()), (0.0, 0.0), (0.0, -0.0)] {
+        assert!(circular_arc_v2_candidate::circular_arc(&v2_arc(Vec2::ZERO, 1.0, start, sweep), 0.1, 64).is_err());
+    }
+}
+
+#[test]
+fn v2_invalid_parameters_and_nonarcs_refuse_with_bounded_work() {
+    let good = v2_arc(Vec2::ZERO, 1.0, 0.0, PI);
+    for error in [0.0, -0.0, -1.0, f64::NAN, f64::INFINITY, f64::NEG_INFINITY] {
+        assert!(circular_arc_v2_candidate::circular_arc(&good, error, 64).is_err());
+    }
+    for cap in [0, 65, usize::MAX] {
+        assert!(circular_arc_v2_candidate::circular_arc(&good, 1.0, cap).is_err());
+    }
+    for value in [f64::NAN, f64::INFINITY, f64::NEG_INFINITY] {
+        for arc in [v2_arc(p(value, 0.0), 1.0, 0.0, PI), v2_arc(p(0.0, value), 1.0, 0.0, PI), v2_arc(Vec2::ZERO, 1.0, value, PI), v2_arc(Vec2::ZERO, 1.0, 0.0, value)] {
+            assert!(circular_arc_v2_candidate::circular_arc(&arc, 1.0, 64).is_err());
+        }
+    }
+    assert!(circular_arc_v2_candidate::circular_arc(&line(Vec2::ZERO, Vec2::X), 1.0, 64).is_err());
+}
+
+#[test]
+fn v2_serial_failures_and_other_unit_requests_do_not_replace_retained_results() {
+    let arc = v2_arc(Vec2::ZERO, 1.0, 0.0, PI);
+    let first = circular_arc_v2_candidate::circular_arc(&arc, 0.1, 1).unwrap();
+    let bits = |result: &circular_arc_v2_candidate::ArcCubics| {
+        result.pieces.iter().flat_map(|p| v2_controls(p).into_iter().flat_map(|p| [p.x.to_bits(), p.y.to_bits()]))
+            .chain(std::iter::once(result.error_bound.to_bits())).collect::<Vec<_>>()
+    };
+    let before = bits(&first);
+    assert!(circular_arc_v2_candidate::circular_arc(&arc, 0.1, 0).is_err());
+    let grid_arc = v2_arc(p(1e6, 2e6), 1e5, 0.0, FRAC_PI_2);
+    v2_check(&circular_arc_v2_candidate::circular_arc(&grid_arc, 9.0, 64).unwrap(), 9.0, 64);
+    assert!(circular_arc_v2_candidate::circular_arc(&arc, 1e-4, 1).is_err());
+    assert_eq!(bits(&circular_arc_v2_candidate::circular_arc(&arc, 0.1, 1).unwrap()), before);
+    assert_eq!(bits(&first), before);
+}
