+    let bound = |name: &str| {
+        let start = pairs.iter().position(|p| *p == (9, name)).unwrap();
+        let fields: Vec<_> = pairs[start + 1..].iter().take_while(|p| p.0 != 9 && p.0 != 0).copied().collect();
+        let entity = (name, fields);
