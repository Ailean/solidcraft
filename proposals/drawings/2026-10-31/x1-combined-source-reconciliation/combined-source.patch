+fn ellipse_quarters(center: Vec2, u: Vec2, v: Vec2) -> Loop2 {
+    let axes = [u, v, -u, -v];
+    Loop2 {
+        segs: (0..4)
+            .map(|i| Seg2::Conic {
+                a: center + axes[i],
+                apex: (center + axes[i]) + axes[(i + 1) % 4],
+                b: center + axes[(i + 1) % 4],
+                w: std::f64::consts::FRAC_1_SQRT_2,
+            })
+            .collect(),
+    }
+}
