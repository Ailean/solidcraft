+            (Vec2::new(-9.0, -16.0), Vec2::new(15.0, -40.0), Vec2::new(15.0, 0.0), 0.4472135954999579),
+        ]
+    } else {
+        vec![
+            (Vec2::new(9.0, -16.0), Vec2::new(25.0, 0.0), Vec2::new(9.0, 16.0), 0.6),
+            (Vec2::new(9.0, 16.0), Vec2::new(0.0, 25.0), Vec2::new(-9.0, 16.0), 0.8),
+            (Vec2::new(-9.0, 16.0), Vec2::new(-25.0, 0.0), Vec2::new(-9.0, -16.0), 0.6),
+            (Vec2::new(-9.0, -16.0), Vec2::new(0.0, -25.0), Vec2::new(9.0, -16.0), 0.8),
+        ]
+    };
