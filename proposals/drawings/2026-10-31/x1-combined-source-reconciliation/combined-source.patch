+fn invalid(path: &[Seg2], style: DxfPathStyle) -> String {
+    match path_shapes(DxfPath::Open(path), style) {
+        Err(IoError::Invalid(message)) => message,
+        other => panic!("expected contextual invalid-path error, got {other:?}"),
+    }
+}
