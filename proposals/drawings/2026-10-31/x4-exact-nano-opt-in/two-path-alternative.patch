+fn exact_nano_length(value: f64) -> Result<f64> {
+    let text = length_decimal::length_decimal(value).map_err(|error| IoError::Invalid(error.message().into()))?;
+    text.as_str().map_err(|error| IoError::Invalid(error.message().into()))?
+        .parse::<f64>().ok().filter(|number| number.is_finite())
+        .ok_or_else(|| IoError::Invalid("DXF exact length cannot be represented".into()))
+}
+
+fn exact_nano_point(point: Vec2) -> Result<Vec2> {
+    Ok(Vec2::new(exact_nano_length(point.x)?, exact_nano_length(point.y)?))
+}
+
+fn exact_nano_values<T>(values: impl ExactSizeIterator<Item = Result<T>>) -> Result<Vec<T>> {
+    if values.len() > MAX_DXF_FILE_VALUES {
+        return Err(IoError::Invalid("DXF exact length payload exceeds the supported limit".into()));
+    }
+    let mut output = Vec::new();
+    output.try_reserve_exact(values.len()).map_err(|_| IoError::Invalid("DXF exact length allocation failed".into()))?;
+    for value in values {
+        output.push(value?);
+    }
+    Ok(output)
+}
+
+fn exact_nano_points(points: &[Vec2]) -> Result<Vec<Vec2>> {
+    let emitted = exact_nano_values(points.iter().map(|point| exact_nano_point(*point)))?;
+    for (old, new) in points.windows(2).zip(emitted.windows(2)) {
+        if let ([a, b], [qa, qb]) = (old, new)
+            && a != b && qa == qb
+        {
+            return Err(IoError::Invalid("DXF exact length grid collapses distinct adjacent points".into()));
+        }
+    }
+    Ok(emitted)
+}
+
+fn exact_nano_text(text: &str) -> Result<String> {
+    let mut output = String::new();
+    output.try_reserve_exact(text.len()).map_err(|_| IoError::Invalid("DXF exact length text allocation failed".into()))?;
+    output.push_str(text);
+    Ok(output)
+}
