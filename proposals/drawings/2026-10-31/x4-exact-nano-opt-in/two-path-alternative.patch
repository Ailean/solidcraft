+impl DxfFile<DxfShape> {
+    /// Opt in to exact 1e-9 mm length ticks (stored-f64 nearest, half ties away).
+    /// Existing free-function writers retain their original spelling and behaviour.
+    /// Lengths and derived extents outside +/-9000000 mm, or geometry collapsed by
+    /// the grid, are refused. Dimensionless fields keep twelve decimals; bulges
+    /// keep their X1 round-trip spelling. Extents remain sampled/control-polygon
+    /// approximations, computed from the values actually emitted.
+    /// AlignedText needs the bounds-provider variant below.
+    pub fn write_dxf_exact_nano_lengths(&self) -> Result<String> {
+        self.write_dxf_exact_nano_lengths_with_text_bounds(|_| {
+            Err(IoError::Invalid("aligned DXF TEXT requires explicit layout bounds".into()))
+        })
+    }
+
+    /// The provider receives the policy-emitted shape, including its quantized
+    /// anchor/height and twelve-decimal angle. It must bound that actual layout.
+    /// No source entity is changed. Existing default providers still see original
+    /// geometry through write_dxf_file_with_text_bounds.
+    pub fn write_dxf_exact_nano_lengths_with_text_bounds<F>(&self, text_bounds: F) -> Result<String>
+    where
+        F: FnMut(&DxfShape) -> Result<DxfGeometryBounds>,
+    {
+        write_dxf_file_limited_with_policy(
+            self, crate::MAX_DRAWING_BYTES, MAX_DXF_FILE_VALUES, text_bounds, LengthPolicy::ExactNano,
+        )
+    }
+}
