+/// A bounded temporary geometry shadow for admission and sampled extents only.
+/// Emission uses the original source through the exact same scalar formatters.
+/// Knots, weights, angles and ratios are twelve-decimal values; bulges are
+/// round-trip values. This does not infer units from a DXF group number.
+fn exact_nano_shape(shape: &DxfShape) -> Result<DxfShape> {
+    Ok(match shape {
+        DxfShape::Point(point) => DxfShape::Point(exact_nano_point(*point)?),
+        DxfShape::Line(a, b) => DxfShape::Line(exact_nano_point(*a)?, exact_nano_point(*b)?),
+        DxfShape::Circle { c, r } => DxfShape::Circle { c: exact_nano_point(*c)?, r: exact_nano_length(*r)? },
+        DxfShape::Arc { c, r, a0, a1 } => DxfShape::Arc {
+            c: exact_nano_point(*c)?, r: exact_nano_length(*r)?, a0: emitted_number(*a0)?, a1: emitted_number(*a1)?,
+        },
+        DxfShape::Ellipse { c, major, ratio, t0, t1 } => DxfShape::Ellipse {
+            c: exact_nano_point(*c)?, major: exact_nano_point(*major)?,
+            ratio: emitted_number(*ratio)?, t0: emitted_number(*t0)?, t1: emitted_number(*t1)?,
+        },
+        DxfShape::Polyline { points } => DxfShape::Polyline { points: exact_nano_points(points)? },
+        DxfShape::BulgedPolyline { vertices, closed } => {
+            let emitted = exact_nano_values(vertices.iter().map(|vertex| Ok(DxfVertex {
+                at: exact_nano_point(vertex.at)?, bulge: vertex.bulge,
+            })))?;
+            for (old, new) in vertices.windows(2).zip(emitted.windows(2)) {
+                if let ([a, b], [qa, qb]) = (old, new)
+                    && a.at != b.at && qa.at == qb.at
+                {
+                    return Err(IoError::Invalid("DXF exact length grid collapses distinct adjacent vertices".into()));
+                }
+            }
+            DxfShape::BulgedPolyline { vertices: emitted, closed: *closed }
+        }
+        DxfShape::Spline { degree, knots, ctrl, weights } => DxfShape::Spline {
+            degree: *degree,
+            knots: exact_nano_values(knots.iter().map(|knot| emitted_number(*knot)))?,
+            ctrl: exact_nano_points(ctrl)?,
+            weights: weights.as_ref().map(|weights| exact_nano_values(weights.iter().map(|weight| emitted_number(*weight)))).transpose()?,
+        },
+        DxfShape::Text { at, height, angle_deg, text } => DxfShape::Text {
+            at: exact_nano_point(*at)?, height: exact_nano_length(*height)?,
+            angle_deg: emitted_number(*angle_deg)?, text: exact_nano_text(text)?,
+        },
+        DxfShape::AlignedText { at, height, angle_deg, text, horizontal, vertical } => DxfShape::AlignedText {
+            at: exact_nano_point(*at)?, height: exact_nano_length(*height)?, angle_deg: emitted_number(*angle_deg)?,
+            text: exact_nano_text(text)?, horizontal: *horizontal, vertical: *vertical,
+        },
+    })
+}
