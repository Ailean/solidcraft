+    fn nano_entity_record<'a>(text: &'a str, kind: &str) -> &'a str {
+        let entities = text.split_once("  2\nENTITIES\n").unwrap().1;
+        let marker = format!("  0\n{kind}\n");
+        entities.split_once(marker.as_str()).unwrap().1.split("  0\n").next().unwrap()
