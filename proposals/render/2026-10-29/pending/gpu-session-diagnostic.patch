 // D3D12 shader compilation is avoided; the user can select a CPU image method instead.
 const VULKAN_ONLY: &str = "the GPU path tracer requires a Vulkan driver (Metal on macOS); select a CPU image method when none is available";
+
+/// Explain a metadata-only refusal without treating it as a driver survey.
+/// The caller retains the existing backend guard before any device is opened.
+fn viewport_path_refusal(backend: wgpu::Backend, windows: bool) -> JobError {
+    let reason = if windows && !matches!(backend, wgpu::Backend::Vulkan | wgpu::Backend::Metal) {
+        format!(
+            "GPU path tracing is unavailable in this Windows session: the viewport uses {backend:?}, while path tracing requires Vulkan. \
+             This request did not open a Vulkan device and did not test driver availability. Select a CPU image method to continue."
+        )
+    } else {
+        format!(
+            "GPU path tracing is unavailable for the selected graphics backend and configured backend policy; the viewport uses {backend:?}. \
+             Vulkan, or Metal on macOS, is required. Driver availability was not established. Select a CPU image method to continue."
+        )
+    };
+    gpu(reason)
+}
 
 /// Backends a viewport's path device may open, before any driver is loaded.
 fn viewport_path_backends(backend: wgpu::Backend, windows: bool) -> wgpu::Backends {
