+fn near_coordinate_cases(mut check: impl FnMut(Triangle, Triangle, Ray, usize, f64)) {
+    for axis in 0..3 {
+        for scale in [1e-6, 1.0, 1e6] {
+            for delta in [1e-16, 1e-14, 1e-12] {
+                for translated in [false, true] {
+                    let translation = if translated { Vec3::new(1e8, -2e8, 0.0) } else { Vec3::ZERO };
+                    let transform = |v| permute(v * scale + translation, axis);
+                    let mut vertices = floor();
+                    vertices[1].z = delta;
+                    let vertices = vertices.map(transform);
+                    let far = Triangle::new(
+                        [Vec3::new(-1200.0, -1200.0, 1.0), Vec3::new(-1000.0, -1200.0, 1.0), Vec3::new(-1000.0, -1000.0, 1.0)]
+                            .map(transform),
+                    ).unwrap();
+                    for reverse in [false, true] {
+                        let [a, b, c] = vertices;
+                        let triangle = Triangle::new(if reverse { [a, c, b] } else { [a, b, c] }).unwrap();
+                        let (x, y) = (73.17, -21.19);
+                        let point = transform(Vec3::new(x, y, delta * (x - y) / 360.0));
+                        for direction in [Vec3::new(0.7, -1.0, 0.2), Vec3::new(-1.0, 0.3, 1e-6)] {
+                            for sign in [-1.0, 1.0] {
+                                let ray = spawned(triangle, point, scale, permute(direction * sign, axis));
+                                check(triangle, far, ray, axis, scale);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+fn planar_cursor_result(bvh: &Bvh, ray: Ray, any: bool) -> Option<Hit> {
+    let cancel = CancelToken::default();
+    let mut work = WorkBudget::new(MAX_WORK).unwrap();
+    let mut cursor = bvh::TraceCursor::new(ray, any);
+    // These fixtures contain at most three triangles. Bound stepping by structure,
+    // not wall-clock time, and fail if the cursor never publishes its answer.
+    for _ in 0..256 {
+        if let Some(result) = cursor.step(bvh, &mut work, &cancel).unwrap() {
+            return result;
+        }
+    }
+    panic!("small planar fixture cursor did not complete");
+}
