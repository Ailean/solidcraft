+#[test]
+fn nonconstant_dyadic_plane_keeps_its_tiny_positive_closed_depth() {
+    let length = (1_u64 << 39) as f64;
+    let elevation = f64::from_bits(1_u64 << 34); // 2^-1040
+    let expected = f64::from_bits(3_u64 << 33); // 3 * 2^-1041
+    for axis in 0..3 {
+        let vertices = [Vec3::ZERO, Vec3::new(length, 0.0, elevation), Vec3::new(0.0, length, elevation)].map(|v| permute(v, axis));
+        for reverse in [false, true] {
+            let [a, b, c] = vertices;
+            let triangle = Triangle::new(if reverse { [a, c, b] } else { [a, b, c] }).unwrap();
+            let origin = permute(Vec3::new(length / 4.0, length / 4.0, -elevation), axis);
+            let direction = permute(Vec3::Z, axis);
+            // The vertex plane is z=e*(x+y)/L. At this interior point it is
+            // e/2, hence the exact forward depth from -e is 3e/2.
+            let closed = Ray::new(origin, direction, expected, expected).unwrap();
+            assert_eq!(triangle.intersect(&closed).unwrap().distance, expected);
+            let broad = Ray::new(origin, direction, 0.0, elevation * 4.0).unwrap();
+            assert_eq!(triangle.intersect(&broad).unwrap().distance, expected);
+            assert!(triangle.intersect(&Ray::new(origin, direction, expected.next_up(), elevation * 4.0).unwrap()).is_none());
+            assert!(triangle.intersect(&Ray::new(origin, direction, 0.0, expected.next_down()).unwrap()).is_none());
+        }
+    }
+}
+
+fn dyadic_cursor_result(bvh: &Bvh, ray: Ray, any: bool) -> Option<Hit> {
+    let cancel = CancelToken::default();
+    let mut work = WorkBudget::new(MAX_WORK).unwrap();
+    let mut cursor = bvh::TraceCursor::new(ray, any);
+    for _ in 0..128 {
+        if let Some(result) = cursor.step(bvh, &mut work, &cancel).unwrap() {
+            return result;
+        }
+    }
+    panic!("two-triangle dyadic cursor did not complete");
+}
