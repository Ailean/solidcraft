+#[test]
+fn almost_coordinate_planes_leave_both_sides_after_shared_spawn_without_self_hits() {
+    near_coordinate_cases(|triangle, far, ray, _, _| {
+        assert!(far.intersect(&ray).is_none(), "the remote fixture must not occlude this ray");
+        assert!(triangle.intersect(&ray).is_none(), "departed triangle={triangle:?}, ray={ray:?}");
+    });
+}
