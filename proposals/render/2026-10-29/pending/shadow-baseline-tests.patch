+#[test]
+fn oblique_plane_depth_preserves_closed_edges_intervals_grazing_and_closest_ties() {
+    for axis in 0..3 {
+        let unpermute = |v: Vec3| match axis {
+            0 => Vec3::new(v.y, v.z, v.x),
+            1 => Vec3::new(v.z, v.x, v.y),
+            _ => v,
+        };
+        for translation in [Vec3::ZERO, Vec3::new(100.0, -200.0, 300.0)] {
+            let transform = |v| permute(v + translation, axis);
+            let [a, b, c, d] = [Vec3::new(-4.0, -4.0, -4.0), Vec3::new(4.0, -4.0, 4.0), Vec3::new(4.0, 4.0, 4.0), Vec3::new(-4.0, 4.0, -4.0)]
+                .map(transform);
+            for reverse in [false, true] {
+                let first = Triangle::new(if reverse { [a, c, b] } else { [a, b, c] }).unwrap();
+                let second = Triangle::new(if reverse { [a, d, c] } else { [a, c, d] }).unwrap();
+                for point in [Vec3::new(1.0, 1.0, 1.0), Vec3::new(4.0, 4.0, 4.0)] {
+                    let origin = transform(point + Vec3::Z * 8.0);
+                    let direction = permute(-Vec3::Z, axis);
+                    let ray = Ray::new(origin, direction, 8.0, 8.0).unwrap();
+                    assert_eq!(first.intersect(&ray).unwrap().distance, 8.0);
+                    assert_eq!(second.intersect(&ray).unwrap().distance, 8.0);
+                    assert!(first.intersect(&Ray::new(origin, direction, 8.0_f64.next_up(), 12.0).unwrap()).is_none());
+                    assert!(first.intersect(&Ray::new(origin, direction, 0.0, 8.0_f64.next_down()).unwrap()).is_none());
+                    for leaf_size in [1, 2, 8] {
+                        for sources in [vec![first, second], vec![second, first], vec![first, first]] {
+                            let bvh = build(sources, leaf_size);
+                            let hit = bvh.closest_hit(&ray, &mut WorkBudget::new(MAX_WORK).unwrap(), &CancelToken::default()).unwrap().unwrap();
+                            assert_eq!(hit.primitive_index, 0);
+                            assert_eq!(planar_cursor_result(&bvh, ray, false).unwrap().primitive_index, 0);
+                        }
+                    }
+                }
+                // Independent analytic plane z=x. Use the actual normalized ray,
+                // not the production plane normal, for the expected distance.
+                for tilt in [1.0 / 1024.0, 1.0 / 1_073_741_824.0] {
+                    let direction = Vec3::new(1.0, 0.0, 1.0 + tilt);
+                    let ray = Ray::new(transform(Vec3::new(1.0, 0.0, 1.0) - direction * 4.0), permute(direction, axis), 0.0, 20.0).unwrap();
+                    let origin = unpermute(ray.origin()) - translation;
+                    let direction = unpermute(ray.direction());
+                    let expected = (origin.x - origin.z) / (direction.z - direction.x);
+                    assert!(expected.is_finite() && expected > 0.0);
+                    assert_eq!(first.intersect(&ray).unwrap().distance, expected);
+                }
+                for zero in [0.0, -0.0] {
+                    let ray = Ray::new(transform(Vec3::new(1.0, 0.0, 1.0)), permute(Vec3::new(1.0, zero, 1.0), axis), 0.0, 20.0).unwrap();
+                    assert!(first.intersect(&ray).is_none(), "a ray in the oblique plane remains a miss");
+                }
+            }
+        }
+    }
+}
