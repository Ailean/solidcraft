+#[test]
+fn a_distinct_near_oblique_blocker_keeps_its_analytic_depth_after_spawn() {
+    let length = (1_u64 << 39) as f64;
+    let elevation = f64::from_bits(1_u64 << 34); // 2^-1040
+    let expected = f64::from_bits(3_u64 << 33); // 3 * 2^-1041
+    for axis in 0..3 {
+        let source = [Vec3::ZERO, Vec3::new(length, 0.0, 0.0), Vec3::new(0.0, length, 0.0)].map(|v| permute(v, axis));
+        for reverse in [false, true] {
+            let [a, b, c] = source;
+            let departed = Triangle::new(if reverse { [a, c, b] } else { [a, b, c] }).unwrap();
+            let point = permute(Vec3::new(length / 4.0, length / 4.0, 0.0), axis);
+            let spawned = spawned(departed, point, 1.0, permute(Vec3::Z, axis));
+            let origin_height = component(spawned.origin(), axis);
+            // Anchor the independent oblique blocker above the actual spawned
+            // ray. Its three heights differ; no exact-coordinate-plane shortcut
+            // applies. At x=y=L/4 its height above the origin is exactly3e/2.
+            let blocker = [
+                Vec3::new(0.0, 0.0, origin_height + elevation),
+                Vec3::new(length, 0.0, origin_height + elevation * 2.0),
+                Vec3::new(0.0, length, origin_height + elevation * 2.0),
+            ].map(|v| permute(v, axis));
+            let [a, b, c] = blocker;
+            let blocker = Triangle::new(if reverse { [a, c, b] } else { [a, b, c] }).unwrap();
+            let ray = Ray::new(spawned.origin(), spawned.direction(), expected, expected).unwrap();
+            assert!(departed.intersect(&ray).is_none());
+            assert_eq!(blocker.intersect(&ray).unwrap().distance, expected);
+            let cancel = CancelToken::default();
+            for leaf_size in [1, 2, 8] {
+                for (sources, index) in [(vec![departed, blocker], 1), (vec![blocker, departed], 0)] {
+                    let bvh = build(sources, leaf_size);
+                    let hit = bvh.closest_hit(&ray, &mut WorkBudget::new(MAX_WORK).unwrap(), &cancel).unwrap().unwrap();
+                    assert_eq!(hit.primitive_index, index);
+                    assert_eq!(hit.geometry.distance, expected);
+                    assert!(bvh.any_hit(&ray, &mut WorkBudget::new(MAX_WORK).unwrap(), &cancel).unwrap());
+                    for any in [false, true] {
+                        let hit = dyadic_cursor_result(&bvh, ray, any).unwrap();
+                        assert_eq!(hit.primitive_index, index);
+                        assert_eq!(hit.geometry.distance, expected);
+                    }
+                }
+            }
+        }
+    }
