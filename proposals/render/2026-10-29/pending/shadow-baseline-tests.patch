+#[test]
+fn almost_coordinate_depth_survives_mixed_leaves_and_keeps_distinct_close_blockers() {
+    near_coordinate_cases(|triangle, far, ray, axis, scale| {
+        let cancel = CancelToken::default();
+        let height = 0.005 * scale;
+        let center = ray.at(height / component(ray.direction(), axis).abs()).unwrap();
+        let blocker = Triangle::new(
+            [Vec3::new(-180.0, -180.0, 0.0), Vec3::new(180.0, -180.0, 0.0), Vec3::new(0.0, 180.0, 0.0)]
+                .map(|v| permute(v * scale, axis) + center),
+        ).unwrap();
+        assert!(blocker.intersect(&ray).is_some(), "a distinct nearby triangle must remain visible");
+        for leaf_size in [1, 2, 8] {
+            for sources in [vec![triangle, far], vec![far, triangle]] {
+                let bvh = build(sources, leaf_size);
+                assert!(bvh.closest_hit(&ray, &mut WorkBudget::new(MAX_WORK).unwrap(), &cancel).unwrap().is_none());
+                assert!(!bvh.any_hit(&ray, &mut WorkBudget::new(MAX_WORK).unwrap(), &cancel).unwrap());
+                assert!(planar_cursor_result(&bvh, ray, false).is_none());
+                assert!(planar_cursor_result(&bvh, ray, true).is_none());
+            }
+            for (sources, expected) in [(vec![triangle, far, blocker], 2), (vec![blocker, far, triangle], 0)] {
+                let bvh = build(sources, leaf_size);
+                assert_eq!(bvh.closest_hit(&ray, &mut WorkBudget::new(MAX_WORK).unwrap(), &cancel).unwrap().unwrap().primitive_index, expected);
+                assert!(bvh.any_hit(&ray, &mut WorkBudget::new(MAX_WORK).unwrap(), &cancel).unwrap());
+                assert_eq!(planar_cursor_result(&bvh, ray, false).unwrap().primitive_index, expected);
+                assert_eq!(planar_cursor_result(&bvh, ray, true).unwrap().primitive_index, expected);
+            }
+        }
+    });
+}
