+        // Independent allocation contract: 2 RGB f32 texels = 24 bytes, one
+        // 2-pixel RGBE scanline = 8 bytes, plus the fixed 8192-byte task envelope.
+        let expected_hdr_bytes = encoded_capacity + 24 + 8 + 8192;
