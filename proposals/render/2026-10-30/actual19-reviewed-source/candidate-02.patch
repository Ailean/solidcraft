+        mesh: Arc::new(Mesh {
+            positions: vec![Vec3::new(-20.0,-20.0,2.0),Vec3::new(20.0,-20.0,2.0),
+                Vec3::new(20.0,20.0,2.0),Vec3::new(-20.0,20.0,2.0)],
+            normals: vec![Vec3::Z;4], triangles:vec![[0,1,2],[0,2,3]], ..Default::default()
+        }),
+        color:[255;3], opacity:1.0, surface:None, faces:Vec::new(),
+    });
+    options.dielectrics.push(job::DielectricOptions {
+        body_index:scene.meshes.len()-1, body_name:"Progressive optical sheet".into(),
+        boundary:job::DielectricBoundary::ThinSheet, ior:1.0, absorption_per_mm:[0.0;3], thickness_mm:0.0,
+    });
