+#[derive(Clone,Default)]
+struct CameraTirEvidence {
+    started:bool,
+    first_entry:Option<(Vec3,Vec3,u16)>,
+    tir:bool,
+    transmitted_escape:bool,
+    truncated_top_hit:bool,
+    finite_scalar:f64,
+    physical_tail_bound:f64,
