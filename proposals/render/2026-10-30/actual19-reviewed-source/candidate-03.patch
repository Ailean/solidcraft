+fn cache_final_partial(
+    app: &mut SolveApp, ctx: &egui::Context, handle: &solidcraft_engine::render::job::JobHandle,
+    status: &solidcraft_engine::render::job::JobStatus,
+    partial: &solidcraft_engine::render::job::RenderPartialPreview,
+) -> Result<(), String> {
+    let job = handle.id();
+    if app.render_workspace.view.job != Some(job) { return Ok(()); }
+    let previous = app.render_workspace.final_partial.as_ref()
+        .filter(|cached| cached.info.frame.job == job).map(|cached| cached.sampling);
+    let expected = interactive::PartialExpectation {
+        job, scene_generation: status.scene_generation, request: &status.request,
+        final_dimensions: [status.request.width, status.request.height],
+    };
+    let Some(sampling) = interactive::validate_partial_metadata(
+        &expected, &partial.info, partial.png().len(), partial.covered().len(), previous,
+    )? else { return Ok(()); };
+    let image = interactive::decode_partial_image(
+        &status.request, &partial.info, partial.png(), partial.covered(), sampling, ctx.input(|input| input.max_texture_side),
+    ).map(|pixels| ctx.load_texture("sc_render_final_partial", pixels, egui::TextureOptions::NEAREST));
+    if app.render_workspace.view.job == Some(job) {
+        app.render_workspace.final_partial = Some(FinalPartialImage { info: partial.info.clone(), sampling, image });
+    }
+    // Only texture/provenance survives: the borrowed PNG/coverage/lease is not retained.
