+    fn editor_text(h: &mut Harness, events: Vec<egui::Event>) -> String {
+        fn collect(shape: &egui::Shape, text: &mut String) {
+            match shape {
+                egui::Shape::Text(shape) => { text.push_str(shape.galley.text()); text.push('\n'); }
+                egui::Shape::Vec(shapes) => for shape in shapes { collect(shape,text); },
+                _ => {}
+            }
+        }
+        let mut output = h.ctx.run_ui(
+            egui::RawInput { screen_rect:Some(egui::Rect::from_min_size(egui::Pos2::ZERO,egui::vec2(480.0,3200.0))),events,..Default::default() },
+            |ui| {
+                ui.set_width(420.0);
+                materials::selection_controls(&mut h.app,ui,Some("ManualOptics"));
+            },
+        );
+        let mut text = String::new();
+        for clipped in &output.shapes { collect(&clipped.shape,&mut text); }
+        output.textures_delta.clear();
+        text
+    }
