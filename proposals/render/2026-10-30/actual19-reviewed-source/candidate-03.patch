+            assert!((direction.z.abs()-1.0).abs() < 1e-12);
+            let point = origin + direction * ((4.0-origin.z)/direction.z);
+            assert!(point.x.abs() <= 4.0+1e-9 && point.y.abs() <= 4.0+1e-9);
