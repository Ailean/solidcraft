@@ -0,0 +1,400 @@
+//! Transient CPU Interactive capture, separate from final render ownership/export.
+use std::sync::{Arc, Mutex, Weak};
+use std::time::Duration;
+
+use serde_json::Value;
+use solidcraft_render::job::{
+    self, ErrorCode, JobError, JobHandle,
+    interactive::{CaptureTicket, Interactive, State, VisualRevision},
+};
+
+use crate::{Result, Session, render_jobs::job_error};
+
+pub(crate) type Controller = Mutex<Interactive>;
+
+/// A poisoned lifecycle is never resumed. Cleanup only its owned work, then fail.
+pub(crate) fn with_controller<T>(controller: &Controller, f: impl FnOnce(&mut Interactive) -> job::Result<T>) -> job::Result<T> {
+    match controller.lock() {
+        Ok(mut state) => f(&mut state),
+        Err(poisoned) => {
+            let _ = poisoned.into_inner().disable();
+            Err(JobError::new(ErrorCode::Internal, "Interactive lifecycle lock poisoned"))
+        }
+    }
+}
+
+/// One transient controller for the current document/service registration.
+/// Only Session::interactive_render allocates its dedicated preview namespace.
+pub struct InteractiveRender {
+    document_uid: u64,
+    preview_session: u64,
+    controller: Arc<Controller>,
+}
+
+impl InteractiveRender {
+    pub(crate) fn new(document_uid: u64, preview_session: u64, final_active: bool) -> job::Result<Self> {
+        if document_uid == 0 || preview_session == 0 {
+            return Err(JobError::new(ErrorCode::LimitExceeded, "Interactive identity exhausted"));
+        }
+        let mut state = Interactive::new(preview_session);
+        state.set_final_active(final_active, Duration::ZERO)?;
+        Ok(Self { document_uid, preview_session, controller: Arc::new(Mutex::new(state)) })
+    }
+
+    pub(crate) fn weak(&self) -> Weak<Controller> {
+        Arc::downgrade(&self.controller)
+    }
+
+    fn with<T>(&self, f: impl FnOnce(&mut Interactive) -> job::Result<T>) -> Result<T> {
+        with_controller(&self.controller, f).map_err(job_error)
+    }
+
+    /// Cheap ownership metadata only: no geometry, files, host discovery or work.
+    pub fn is_current(&self, session: &Session) -> bool {
+        self.document_uid == session.uid && session.render_jobs.is_interactive_current(&self.weak())
+    }
+
+    pub fn document_uid(&self) -> u64 {
+        self.document_uid
+    }
+
+    pub fn enable(&self, revision: VisualRevision, now: Duration) -> Result<()> {
+        self.with(|state| state.enable(revision, now))
+    }
+
+    pub fn edit(&self, revision: VisualRevision, now: Duration) -> Result<()> {
+        self.with(|state| state.edit(revision, now))
+    }
+
+    pub fn disable(&self) -> Result<()> {
+        self.with(Interactive::disable)
+    }
+
+    pub fn pause(&self) -> Result<()> {
+        self.with(Interactive::pause)
+    }
+
+    pub fn resume(&self, now: Duration) -> Result<()> {
+        self.with(|state| state.resume(now))
+    }
+
+    pub fn set_final_active(&self, active: bool, now: Duration) -> Result<()> {
+        self.with(|state| state.set_final_active(active, now))
+    }
+
+    pub fn capture(&self, now: Duration) -> Result<Option<CaptureTicket>> {
+        self.with(|state| state.capture(now))
+    }
+
+    pub fn state(&self) -> Result<State> {
+        self.with(|state| state.state())
+    }
+
+    pub fn current(&self) -> Result<Option<JobHandle>> {
+        self.with(|state| Ok(state.current().cloned()))
+    }
+
+    /// Capture failures live in the controller; worker failures live in its job.
+    pub fn error(&self) -> Result<Option<String>> {
+        self.with(|state| {
+            if let Some(error) = state.error() {
+                return Ok(Some(error.to_string()));
+            }
+            let status = state.current().map(JobHandle::status).transpose()?;
+            Ok(status.and_then(|status| status.error).map(|error| error.to_string()))
+        })
+    }
+
+    pub fn capture_failed(&self, ticket: CaptureTicket, message: String) -> Result<()> {
+        self.with(|state| {
+            state.capture_failed(ticket, JobError::new(ErrorCode::InvalidScene, message));
+            Ok(())
+        })
+    }
+
+    fn reject_snapshot(&self, ticket: CaptureTicket, error: JobError) -> Result<Snapshot> {
+        self.with(|state| {
+            state.capture_failed(ticket, error.clone());
+            Ok(())
+        })?;
+        Err(job_error(error))
+    }
+
+    /// Freeze one complete UI intent and document. The caller supplies the same
+    /// immutable numerical intent that produced this visual revision/ticket.
+    /// A name, CAD revision or reused Value alone is not visual provenance.
+    pub fn snapshot(&self, session: &Session, ticket: CaptureTicket, params: &Value) -> Result<Snapshot> {
+        if !self.is_current(session) || ticket.job_id().session != self.preview_session || ticket.revision().scene_generation != session.revision {
+            return self.reject_snapshot(
+                ticket,
+                JobError::new(ErrorCode::WrongOwner, "Interactive capture belongs to another document or service revision"),
+            );
+        }
+        if session.model.is_stale() {
+            return self.reject_snapshot(ticket, JobError::new(ErrorCode::InvalidScene, "finish the modelling gesture before Interactive capture"));
+        }
+        if !self.with(|state| Ok(state.accepts_capture(ticket)))? {
+            return self.reject_snapshot(ticket, JobError::new(ErrorCode::WrongOwner, "Interactive capture ticket is no longer current"));
+        }
+        Ok(Snapshot {
+            session: session.scratch(),
+            params: params.clone(),
+            ticket,
+            controller: self.weak(),
+            scope: solidcraft_io::vfs::current_scope(),
+        })
+    }
+}
+
+impl Drop for InteractiveRender {
+    fn drop(&mut self) {
+        let _ = self.disable();
+    }
+}
+
+/// Immutable capture envelope; no engine worker or queue is created here.
+/// The caller maintains one app-wide capture worker, including across tab swaps.
+pub struct Snapshot {
+    session: Session,
+    params: Value,
+    ticket: CaptureTicket,
+    controller: Weak<Controller>,
+    scope: Option<solidcraft_io::vfs::PathScope>,
+}
+
+/// Internal output of the ordinary authoritative CPU preparation boundary.
+pub(crate) struct Prepared {
+    pub(crate) scene: solidcraft_render::ProductScene,
+    pub(crate) request: job::ImageRequest,
+    pub(crate) options: job::JobOptions,
+    pub(crate) environment: Option<solidcraft_render::lighting::environment_input::EnvironmentInput>,
+}
+
+/// This guard only receives a record just created by this capture, never a
+/// caller's retained/manual/foreign handle. Dropping a JobHandle alone is not a
+/// cancellation request: native queue/running work keeps its own clone.
+struct Unadopted {
+    job: JobHandle,
+    adopted: bool,
+}
+
+impl Drop for Unadopted {
+    fn drop(&mut self) {
+        if !self.adopted {
+            let _ = self.job.cancel();
+        }
+    }
+}
+
+/// Adopt a newly submitted local record. Even an equal-ID duplicate is cancelled
+/// when rejected: it is a different new record, not a copy of the accepted job.
+pub(crate) fn adopt_created(controller: &Controller, ticket: CaptureTicket, job: JobHandle) -> job::Result<bool> {
+    if job.id().session != ticket.job_id().session {
+        return Err(JobError::new(ErrorCode::WrongOwner, "created Interactive record has another identity"));
+    }
+    let mut pending = Unadopted { job, adopted: false };
+    let accepted = with_controller(controller, |state| state.attach(ticket, pending.job.clone()))?;
+    pending.adopted = accepted;
+    Ok(accepted)
+}
+
+impl Snapshot {
+    /// Correlate the caller's receiver and discard old errors after tab changes.
+    pub fn ticket(&self) -> CaptureTicket {
+        self.ticket
+    }
+
+    pub fn document_uid(&self) -> u64 {
+        self.session.uid
+    }
+
+    /// Invoke beside the window, never while holding a lifecycle lock. Both
+    /// preparation and admission may be long; edits/finals can invalidate either.
+    pub fn run(mut self) -> Result<bool> {
+        let Some(controller) = self.controller.upgrade() else { return Ok(false) };
+        if !with_controller(&controller, |state| Ok(state.accepts_capture(self.ticket))).map_err(job_error)? {
+            return Ok(false);
+        }
+        let result = (|| {
+            let prepared = solidcraft_io::vfs::scoped(self.scope.take(), || crate::cmd::prepare_interactive(&self.session, &self.params))?;
+            if !with_controller(&controller, |state| Ok(state.accepts_capture(self.ticket))).map_err(job_error)? {
+                return Ok(false);
+            }
+            let host = self
+                .session
+                .render_job_host()
+                .ok_or_else(|| job_error(JobError::new(ErrorCode::HostUnavailable, "CPU image host is unavailable")))?;
+            let job = host
+                .submit_with_environment_and_options(
+                    self.ticket.job_id(),
+                    self.ticket.revision().scene_generation,
+                    prepared.scene,
+                    prepared.request,
+                    prepared.options,
+                    prepared.environment,
+                )
+                .map_err(job_error)?;
+            adopt_created(&controller, self.ticket, job).map_err(job_error)
+        })();
+        if let Err(error) = &result {
+            let _ = with_controller(&controller, |state| {
+                state.capture_failed(self.ticket, JobError::new(ErrorCode::InvalidScene, error.to_string()));
+                Ok(())
+            });
+        }
+        result
+    }
+}
+
+/// Opaque visual-source stamp: no placed world, mesh, strong document or B-rep
+/// ownership. Construct only after the previous stamp stops matching; retain it
+/// and call is_current on each frame instead of cloning session metadata again.
+pub struct SceneIdentity {
+    uid: u64,
+    revision: u64,
+    document: Weak<solidcraft_doc::Document>,
+    model: Weak<solidcraft_doc::ModelState>,
+    pending_moves: std::collections::BTreeMap<u64, solidcraft_doc::Mat>,
+    active_sketch: Option<u64>,
+    active_component: u64,
+    active_occurrence_path: Option<Vec<u64>>,
+    visibility: solidcraft_doc::Visibility,
+}
+
+impl SceneIdentity {
+    /// Exact metadata comparison. model.state only clones the existing evaluated
+    /// Arc; it neither evaluates nor places bodies nor obtains a display mesh.
+    /// Weak allocation identities cannot alias a later allocation while retained.
+    pub fn is_current(&self, session: &Session) -> bool {
+        self.uid == session.uid
+            && self.revision == session.revision
+            && Weak::ptr_eq(&self.document, &Arc::downgrade(&session.doc))
+            && Weak::ptr_eq(&self.model, &Arc::downgrade(&session.model.state()))
+            && self.pending_moves == session.pending_moves
+            && self.active_sketch == session.active_sketch
+            && self.active_component == session.active_component
+            && self.active_occurrence_path == session.active_occurrence_path
+            && self.visibility == session.visibility
+    }
+}
+
+impl Session {
+    /// Source identity without computing cold assembly placements or meshes.
+    /// Stale modelling gestures must still be rejected separately before capture.
+    /// View camera/draft/output edits belong to the caller's visual intent stamp.
+    pub fn interactive_scene_identity(&self) -> SceneIdentity {
+        SceneIdentity {
+            uid: self.uid,
+            revision: self.revision,
+            document: Arc::downgrade(&self.doc),
+            model: Arc::downgrade(&self.model.state()),
+            pending_moves: self.pending_moves.clone(),
+            active_sketch: self.active_sketch,
+            active_component: self.active_component,
+            active_occurrence_path: self.active_occurrence_path.clone(),
+            visibility: self.visibility.clone(),
+        }
+    }
+}
+
+impl Session {
+    /// Existing prepared world only, for Interactive reflection-binding proof.
+    /// None is not a capture-availability decision: SceneIdentity remains valid
+    /// for cold assemblies and the capture worker prepares their real world.
+    pub fn interactive_cached_world_state(&self) -> Option<Arc<solidcraft_doc::ModelState>> {
+        self.cached_world_state()
+    }
+}
+
+// Exact identity checks must not prepare cold geometry on the window thread.
+#[cfg(test)]
+#[allow(clippy::unwrap_used, clippy::expect_used, clippy::panic)]
+mod scene_identity_tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn cold_assembly_stamp_neither_places_nor_meshes() {
+        let mut session = Session::default();
+        session.execute("solid.box", &json!({"length":10,"width":20,"height":5,"body_name":"Source"})).unwrap();
+        // A root body plus an empty placed component is a valid cold assembly.
+        let doc = session.doc_mut();
+        doc.components.push(solidcraft_doc::Component { id: 100, name: "Empty component".into(), ..Default::default() });
+        doc.occurrences.push(solidcraft_doc::Occurrence {
+            id: 101,
+            component: 100,
+            parent: 0,
+            name: "Empty placement".into(),
+            transform: solidcraft_doc::IDENTITY,
+            grounded: false,
+        });
+        assert!(session.world_cache.lock().unwrap().is_none());
+        let state = session.model.state();
+        assert!(state.body("Source").unwrap().cached_mesh().is_none());
+        let stamp = session.interactive_scene_identity();
+        for _ in 0..10 {
+            assert!(stamp.is_current(&session));
+        }
+        assert!(session.world_cache.lock().unwrap().is_none());
+        assert!(state.body("Source").unwrap().cached_mesh().is_none());
+    }
+
+    #[test]
+    fn exact_context_and_visibility_changes_invalidate_without_revision() {
+        let mut session = Session::default();
+        let revision = session.revision;
+        let stamp = session.interactive_scene_identity();
+        session.pending_moves.insert(7, solidcraft_doc::IDENTITY);
+        assert!(!stamp.is_current(&session));
+        session.pending_moves.clear();
+        assert!(stamp.is_current(&session));
+        session.active_component = 7;
+        assert!(!stamp.is_current(&session));
+        session.active_component = 0;
+        session.active_occurrence_path = Some(vec![7, 8]);
+        assert!(!stamp.is_current(&session));
+        session.active_occurrence_path = None;
+        session.active_sketch = Some(9);
+        assert!(!stamp.is_current(&session));
+        session.active_sketch = None;
+        session.visibility.hidden_occurrences.push(vec![7, 8]);
+        assert!(!stamp.is_current(&session));
+        session.visibility.hidden_occurrences.clear();
+        session.visibility.hidden_folders.push("c0/bodies".into());
+        assert!(!stamp.is_current(&session));
+        assert_eq!(session.revision, revision);
+    }
+
+    #[test]
+    fn stamp_has_no_strong_document_or_model_retention() {
+        let session = Session::default();
+        let model = session.model.state();
+        let doc_count = Arc::strong_count(&session.doc);
+        let model_count = Arc::strong_count(&model);
+        let doc = Arc::downgrade(&session.doc);
+        let weak_model = Arc::downgrade(&model);
+        let stamp = session.interactive_scene_identity();
+        assert_eq!(Arc::strong_count(&session.doc), doc_count);
+        assert_eq!(Arc::strong_count(&model), model_count);
+        assert!(stamp.is_current(&session));
+        drop(model);
+        drop(session);
+        assert!(doc.upgrade().is_none());
+        assert!(weak_model.upgrade().is_none());
+        // Retained Weak allocation identities cannot be recycled for a new object.
+        let replacement = Session { uid: stamp.uid, revision: stamp.revision, ..Default::default() };
+        assert!(!stamp.is_current(&replacement));
+    }
+
+    #[test]
+    fn same_document_and_revision_do_not_hide_a_replaced_evaluated_model() {
+        let mut session = Session::default();
+        let stamp = session.interactive_scene_identity();
+        session.model = Session::default().model;
+        assert!(!stamp.is_current(&session));
+        let refreshed = session.interactive_scene_identity();
+        assert!(refreshed.is_current(&session));
+        session.revision += 1;
+        assert!(!refreshed.is_current(&session));
+    }
+}
diff --git a/crates/ui-egui/src/render_workspace_interactive.rs b/crates/ui-egui/src/render_workspace_interactive.rs
new file mode 100644
--- /dev/null
+++ b/crates/ui-egui/src/render_workspace_interactive.rs
@@ -0,0 +1,649 @@
+//! Opt-in CPU checkpoints. This cache and its capture receiver are app-wide,
+//! never part of saved setups, final results or export ownership.
+use super::ImageMethod;
+use crate::{SolveApp, theme::Tokens, ui_kit};
+use serde_json::{Value, json};
+#[cfg(not(target_arch = "wasm32"))]
+use solidcraft_engine::render_interactive::Snapshot;
+use solidcraft_engine::{
+    render::job::{
+        FrameInfo, HostKind, Integrator, JobId,
+        interactive::{CaptureTicket, State as Phase, VisualRevision},
+    },
+    render_interactive::{InteractiveRender, SceneIdentity},
+    schema::render_ui::Action,
+};
+use std::{sync::mpsc, time::Duration};
+
+struct Intent {
+    scene: SceneIdentity,
+    uid: u64,
+    revision: u64,
+    camera: solidcraft_engine::render::Camera,
+    stale: bool,
+    request: Result<Value, String>,
+}
+
+pub(super) struct Pending {
+    pub(super) uid: u64,
+    pub(super) ticket: CaptureTicket,
+    pub(super) receiver: mpsc::Receiver<Result<bool, String>>,
+}
+#[derive(Clone, Copy, PartialEq, Eq)]
+struct PixelKey {
+    job: JobId,
+    sequence: u32,
+    complete: bool,
+}
+struct Cached {
+    key: PixelKey,
+    revision: VisualRevision,
+    info: FrameInfo,
+    samples: u32,
+    stale: bool,
+    texture: Result<egui::TextureHandle, String>,
+}
+
+pub(super) struct State {
+    context: Option<InteractiveRender>,
+    pub(super) pending: Option<Pending>,
+    issued: Option<CaptureTicket>,
+    observed: Option<Intent>,
+    visual: u64,
+    clock: Duration,
+    phase: Phase,
+    user_paused: bool,
+    final_active: bool,
+    error: Option<String>,
+    frame: Option<Cached>,
+}
+impl Default for State {
+    fn default() -> Self {
+        Self {
+            context: None,
+            pending: None,
+            issued: None,
+            observed: None,
+            visual: 0,
+            clock: Duration::ZERO,
+            phase: Phase::Off,
+            user_paused: false,
+            final_active: false,
+            error: None,
+            frame: None,
+        }
+    }
+}
+impl State {
+    /// Never drop a live receiver to make room for a second capture thread.
+    pub(super) fn reset_document(&mut self) {
+        if let Some(context) = self.context.take() {
+            let _ = context.disable();
+        }
+        self.issued = None;
+        self.observed = None;
+        self.phase = Phase::Off;
+        self.user_paused = false;
+        self.final_active = false;
+        self.error = None;
+        self.frame = None;
+    }
+    #[cfg(test)]
+    pub(super) fn pending(&self) -> bool {
+        self.pending.is_some()
+    }
+    fn revision(&self) -> Option<VisualRevision> {
+        self.observed.as_ref().map(|intent| VisualRevision { scene_generation: intent.revision, visual_revision: self.visual })
+    }
+    fn drain(&mut self, app: &SolveApp) {
+        let Some(pending) = self.pending.take() else { return };
+        let reply = match pending.receiver.try_recv() {
+            Ok(reply) => reply,
+            Err(mpsc::TryRecvError::Empty) => {
+                self.pending = Some(pending);
+                return;
+            }
+            Err(mpsc::TryRecvError::Disconnected) => Err(app.tr("render.interactive_error").into()),
+        };
+        if pending.uid != app.session.uid
+            || self.issued != Some(pending.ticket)
+            || self.revision() != Some(pending.ticket.revision())
+            || self.context.as_ref().is_none_or(|context| !context.is_current(&app.session))
+        {
+            return;
+        }
+        // Final preemption or a user pause invalidates the outstanding ticket;
+        // an expected rejected capture is not a fresh preparation failure.
+        if self.user_paused
+            || self.final_active
+            || self.context.as_ref().is_some_and(|context| matches!(context.state(), Ok(Phase::Paused | Phase::Off)))
+        {
+            return;
+        }
+        match reply {
+            Err(error) => {
+                if let Some(context) = &self.context {
+                    let _ = context.capture_failed(pending.ticket, error.clone());
+                }
+                self.error = Some(error);
+                self.phase = Phase::Error;
+            }
+            Ok(false) => {
+                self.error = Some(app.tr("render.interactive_error").into());
+                self.phase = Phase::Error;
+            }
+            Ok(true) => {}
+        }
+    }
+    fn observe(&mut self, app: &SolveApp) -> Result<(), String> {
+        // The exact-input stamp never computes world placements/meshes.
+        // Preserve a current stamp across request-only edits; its weak identities
+        // prevent pointer reuse without retaining CAD data or changing COW behavior.
+        let stale = app.session.model.is_stale();
+        let request = if stale { Err(app.tr("render.error_finish_gesture").into()) } else { super::interactive_request(app) };
+        let current_scene = self.observed.as_ref().is_some_and(|old| old.scene.is_current(&app.session));
+        if current_scene
+            && self.observed.as_ref().is_some_and(|old| {
+                old.uid == app.session.uid
+                    && old.revision == app.session.revision
+                    && old.camera == app.cam
+                    && old.stale == stale
+                    && old.request == request
+            })
+        {
+            return Ok(());
+        }
+        let scene = match self.observed.take() {
+            Some(old) if current_scene => old.scene,
+            _ => app.session.interactive_scene_identity(),
+        };
+        let intent = Intent { scene, uid: app.session.uid, revision: app.session.revision, camera: app.cam, stale, request };
+        let recovering = self.error.is_some() || self.phase == Phase::Error;
+        self.visual = self.visual.checked_add(1).ok_or_else(|| app.tr("render.interactive_error").to_string())?;
+        self.observed = Some(intent);
+        self.issued = None;
+        self.error = None;
+        if self.user_paused {
+            if let Some(frame) = &mut self.frame {
+                frame.stale = true;
+            }
+        } else {
+            self.frame = None;
+        }
+        if let (Some(context), Some(revision)) = (&self.context, self.revision()) {
+            context.edit(revision, self.clock).map_err(|error| error.to_string())?;
+            if recovering && !self.user_paused {
+                context.resume(self.clock).map_err(|error| error.to_string())?;
+            }
+        }
+        if !stale && let Some(Err(error)) = self.observed.as_ref().map(|intent| &intent.request) {
+            self.error = Some(error.clone());
+        }
+        Ok(())
+    }
+    fn update(&mut self, app: &mut SolveApp, ctx: &egui::Context, dispatch: bool) -> Result<(), String> {
+        self.clock = monotonic(self.clock, ctx.input(|input| input.time));
+        self.drain(app);
+        if self.context.is_none() {
+            return Ok(());
+        }
+        if !super::active(app)
+            || app.render_workspace.view.method != ImageMethod::CpuRaytrace
+            || self.context.as_ref().is_some_and(|context| !context.is_current(&app.session))
+        {
+            self.reset_document();
+            return Ok(());
+        }
+        self.observe(app)?;
+        let final_active = finals_active(app);
+        let suspend = final_active.as_ref().copied().unwrap_or(true) || app.render_workspace.view.result;
+        self.final_active = suspend;
+        let waiting_for_model = self.observed.as_ref().is_some_and(|intent| intent.stale);
+        let context = self.context.as_ref().ok_or_else(|| app.tr("render.interactive_error").to_string())?;
+        context.set_final_active(suspend || waiting_for_model, self.clock).map_err(|error| error.to_string())?;
+        if suspend || waiting_for_model {
+            self.issued = None;
+        }
+        if suspend && !self.user_paused {
+            self.frame = None;
+        }
+        if let Err(error) = final_active {
+            self.error = Some(error);
+        }
+        if waiting_for_model {
+            self.phase = if self.user_paused || suspend { Phase::Paused } else { Phase::Updating };
+            if let Some(frame) = &mut self.frame {
+                frame.stale = true;
+            }
+            return Ok(());
+        }
+        if self.error.is_some() {
+            // Request errors must cancel an already attached old capture, too.
+            context.pause().map_err(|error| error.to_string())?;
+            self.phase = Phase::Error;
+            return Ok(());
+        }
+        self.phase = context.state().map_err(|error| error.to_string())?;
+        if self.phase == Phase::Error {
+            self.error = context.error().map_err(|error| error.to_string())?.or_else(|| Some(app.tr("render.interactive_error").into()));
+            self.frame = None;
+            return Ok(());
+        }
+        self.cache(ctx)?;
+        if !dispatch || self.pending.is_some() || suspend || self.user_paused {
+            return Ok(());
+        }
+        #[cfg(not(target_arch = "wasm32"))]
+        if let Some(ticket) = self
+            .context
+            .as_ref()
+            .ok_or_else(|| app.tr("render.interactive_error").to_string())?
+            .capture(self.clock)
+            .map_err(|error| error.to_string())?
+        {
+            let request = self
+                .observed
+                .as_ref()
+                .and_then(|intent| intent.request.as_ref().ok())
+                .ok_or_else(|| app.tr("render.interactive_error").to_string())?;
+            let snapshot = self
+                .context
+                .as_ref()
+                .ok_or_else(|| app.tr("render.interactive_error").to_string())?
+                .snapshot(&app.session, ticket, request)
+                .map_err(|error| error.to_string())?;
+            self.issued = Some(ticket);
+            self.pending = Some(spawn(snapshot)?);
+            self.phase = Phase::Updating;
+        }
+        Ok(())
+    }
+    fn cache(&mut self, ctx: &egui::Context) -> Result<(), String> {
+        if self.user_paused || self.final_active {
+            return Ok(());
+        }
+        let Some(context) = &self.context else { return Ok(()) };
+        let Some(job) = context.current().map_err(|error| error.to_string())? else { return Ok(()) };
+        let Some(ticket) = self.issued else { return Ok(()) };
+        if job.id() != ticket.job_id() || self.revision() != Some(ticket.revision()) {
+            return Ok(());
+        }
+        let status = job.status().map_err(|error| error.to_string())?;
+        if status.request.integrator != Integrator::Raytrace || status.scene_generation != ticket.revision().scene_generation {
+            return Err(crate::i18n::tr("render.interactive_error").into());
+        }
+        // Prefer an immutable checkpoint. A completed 16-SPP preview is also
+        // provisional and is never inserted into view.job/completed/result slots.
+        let preview = job.preview().map_err(|error| error.to_string())?;
+        if let Some(preview) = preview {
+            let key = PixelKey { job: job.id(), sequence: preview.info.frame_sequence, complete: false };
+            self.cache_png(ctx, key, ticket.revision(), &preview.info.frame, preview.info.samples_per_pixel, (preview.png(), &status.request))?;
+        } else if let Some(frame) = job.frame().map_err(|error| error.to_string())? {
+            let key = PixelKey { job: job.id(), sequence: 0, complete: true };
+            let samples = status.request.raytrace.as_ref().and_then(|options| options.progressive).map_or(0, |options| options.samples_per_pixel);
+            self.cache_png(ctx, key, ticket.revision(), &frame.info, samples, (frame.png(), &status.request))?;
+        }
+        Ok(())
+    }
+    fn cache_png(
+        &mut self,
+        ctx: &egui::Context,
+        key: PixelKey,
+        revision: VisualRevision,
+        info: &FrameInfo,
+        samples: u32,
+        payload: (&[u8], &solidcraft_engine::render::job::ImageRequest),
+    ) -> Result<(), String> {
+        let (png, request) = payload;
+        if self.frame.as_ref().is_some_and(|frame| frame.key == key && frame.revision == revision) {
+            return Ok(());
+        }
+        if info.job != key.job
+            || info.scene_generation != revision.scene_generation
+            || !(1..=16).contains(&samples)
+            || (info.width, info.height) != (request.width, request.height)
+            || info.width > 1024
+            || info.height > 1024
+        {
+            return Err(crate::i18n::tr("render.error_provisional_identity").into());
+        }
+        let texture = super::decode_render_image(
+            png,
+            info.width,
+            info.height,
+            super::captured_image_limits(request),
+            ctx.input(|input| input.max_texture_side),
+        )
+        .map(|image| ctx.load_texture("sc_render_interactive", image, egui::TextureOptions::LINEAR));
+        let error = texture.as_ref().err().cloned();
+        self.frame = Some(Cached { key, revision, info: info.clone(), samples, stale: false, texture });
+        if let Some(error) = error {
+            return Err(error);
+        }
+        Ok(())
+    }
+}
+
+pub(super) fn monotonic(previous: Duration, seconds: f64) -> Duration {
+    if !seconds.is_finite() || seconds < 0.0 {
+        return previous;
+    }
+    match Duration::try_from_secs_f64(seconds) {
+        Ok(now) => previous.max(now),
+        Err(_) => previous,
+    }
+}
+fn finals_active(app: &SolveApp) -> Result<bool, String> {
+    let mut active = false;
+    for session in std::iter::once(&app.session).chain(app.docs.background()) {
+        active |= session.render_final_active().map_err(|error| error.to_string())?;
+    }
+    Ok(active)
+}
+
+pub(super) fn ready(app: &SolveApp) -> Result<(), String> {
+    if cfg!(target_arch = "wasm32") || !super::active(app) || app.render_workspace.view.method != ImageMethod::CpuRaytrace {
+        return Err(app.tr("render.interactive_requires_cpu").into());
+    }
+    let host = app.session.render_job_host().ok_or_else(|| app.tr("render.interactive_requires_cpu").to_string())?;
+    if host.kind() != HostKind::NativeWorker || !host.is_available() || host.validate_integrator(Integrator::Raytrace).is_err() {
+        return Err(app.tr("render.interactive_requires_cpu").into());
+    }
+    if finals_active(app)? || app.render_workspace.view.result {
+        return Err(app.tr("render.interactive_final_active").into());
+    }
+    Ok(())
+}
+
+pub(super) fn apply_command(app: &mut SolveApp, action: Action) -> Result<(), String> {
+    if matches!(action, Action::On | Action::Resume) {
+        ready(app)?;
+    }
+    let mut state = std::mem::take(&mut app.render_workspace.interactive);
+    let result = (|| {
+        match action {
+            Action::Off => state.reset_document(),
+            Action::On => {
+                state.reset_document();
+                state.context = Some(app.session.interactive_render().map_err(|error| error.to_string())?);
+                state.observe(app)?;
+                let revision = state.revision().ok_or_else(|| app.tr("render.interactive_error").to_string())?;
+                state
+                    .context
+                    .as_ref()
+                    .ok_or_else(|| app.tr("render.interactive_error").to_string())?
+                    .enable(revision, state.clock)
+                    .map_err(|error| error.to_string())?;
+                state.phase = Phase::Updating;
+            }
+            Action::Pause => {
+                let context = state.context.as_ref().ok_or_else(|| app.tr("render.interactive_requires_cpu").to_string())?;
+                context.pause().map_err(|error| error.to_string())?;
+                state.user_paused = true;
+                state.issued = None;
+                state.phase = Phase::Paused;
+            }
+            Action::Resume => {
+                state.observe(app)?;
+                if let Some(Err(error)) = state.observed.as_ref().map(|intent| &intent.request) {
+                    return Err(error.clone());
+                }
+                let context = state.context.as_ref().ok_or_else(|| app.tr("render.interactive_requires_cpu").to_string())?;
+                context.resume(state.clock).map_err(|error| error.to_string())?;
+                state.user_paused = false;
+                state.issued = None;
+                state.error = None;
+                state.frame = None;
+                state.phase = Phase::Updating;
+            }
+        }
+        Ok(())
+    })();
+    app.render_workspace.interactive = state;
+    result
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+fn spawn(snapshot: Snapshot) -> Result<Pending, String> {
+    let uid = snapshot.document_uid();
+    let ticket = snapshot.ticket();
+    let (sender, receiver) = mpsc::channel();
+    let _worker = std::thread::Builder::new()
+        .name("solidcraft-interactive-capture".into())
+        .spawn(move || {
+            let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| snapshot.run()))
+                .map_err(|_| crate::i18n::tr("render.interactive_error").to_string())
+                .and_then(|result| result.map_err(|error| error.to_string()));
+            let _ = sender.send(result);
+        })
+        .map_err(|error| error.to_string())?;
+    Ok(Pending { uid, ticket, receiver })
+}
+
+fn refresh(app: &mut SolveApp, ctx: &egui::Context, dispatch: bool) {
+    let mut state = std::mem::take(&mut app.render_workspace.interactive);
+    if let Err(error) = state.update(app, ctx, dispatch) {
+        if let Some(context) = &state.context {
+            let _ = context.pause();
+        }
+        state.error = Some(error);
+        state.phase = Phase::Error;
+        state.frame = None;
+    }
+    let poll = state.pending.is_some() || matches!(state.phase, Phase::Updating | Phase::Refining);
+    app.render_workspace.interactive = state;
+    if poll {
+        ctx.request_repaint_after(Duration::from_millis(100));
+    }
+}
+pub(super) fn tick(app: &mut SolveApp, ctx: &egui::Context) {
+    refresh(app, ctx, true);
+}
+pub(super) fn before_paint(app: &mut SolveApp, ctx: &egui::Context) {
+    refresh(app, ctx, false);
+}
+
+/// Reserve the canvas while an active CPU preview awaits its current pixels.
+/// This never turns a waiting state into a painted image or retains old pixels.
+pub(super) fn awaiting_current_frame(app: &SolveApp) -> bool {
+    let state = &app.render_workspace.interactive;
+    super::active(app)
+        && app.render_workspace.view.method == ImageMethod::CpuRaytrace
+        && !app.render_workspace.view.result
+        && state.context.as_ref().is_some_and(|context| context.is_current(&app.session))
+        && !state.user_paused
+        && !state.final_active
+        && state.error.is_none()
+        && matches!(state.phase, Phase::Updating | Phase::Refining)
+        && state.frame.is_none()
+}
+
+pub(super) fn paint(app: &SolveApp, ui: &egui::Ui, rect: egui::Rect) -> bool {
+    let state = &app.render_workspace.interactive;
+    if state.context.is_none() || state.final_active || state.error.is_some() {
+        return false;
+    }
+    let Some(frame) = &state.frame else { return false };
+    if !state.user_paused && (frame.stale || state.revision() != Some(frame.revision)) {
+        return false;
+    }
+    let Ok(texture) = &frame.texture else { return false };
+    let scale = (rect.width() / frame.info.width as f32).min(rect.height() / frame.info.height as f32);
+    let target = egui::Rect::from_center_size(rect.center(), egui::vec2(frame.info.width as f32, frame.info.height as f32) * scale);
+    ui.painter().with_clip_rect(rect).image(
+        texture.id(),
+        target,
+        egui::Rect::from_min_max(egui::Pos2::ZERO, egui::pos2(1.0, 1.0)),
+        Tokens::get().file_image_tint,
+    );
+    true
+}
+
+/// Place only our card in current-frame space; never move another workspace surface.
+pub(super) fn overlay_bounds(app: &SolveApp, free: egui::Rect) -> egui::Rect {
+    if !free.is_finite() || !free.is_positive() {
+        return egui::Rect::NOTHING;
+    }
+    let gap = Tokens::get().space_8;
+    let available = crate::shell::workspace_content(app, free).shrink(gap);
+    let mut obstacles = Vec::new();
+    for (id, (rect, edge)) in &app.shell.workspace_panels {
+        if *id != "render:interactive-card" && edge.is_none() {
+            obstacles.push(rect.expand(gap));
+        }
+    }
+    if let Some(layout) = &app.viewport.layout {
+        obstacles.extend([layout.axis_view, layout.navigation, layout.confirm].map(|rect| rect.expand(gap)));
+    }
+    crate::viewport_layout::free_rect(available, &obstacles)
+}
+
+pub(crate) fn overlay(app: &mut SolveApp, ui: &egui::Ui, free: egui::Rect) {
+    let bounds = overlay_bounds(app, free);
+    let t = Tokens::get();
+    // Match navigation_card's real chrome, including theme-dependent borders.
+    let chrome = ui_kit::Container::new(ui.ctx(), ui_kit::Surface::Navigation)
+        .frame(ui.ctx(), t.overlay, crate::frame::Side::Left)
+        .inner_margin(t.space_4)
+        .total_margin()
+        .sum();
+    let width = (bounds.width() - chrome.x).min(t.form_card_width);
+    let height = bounds.height() - chrome.y;
+    if !bounds.is_finite() || width < t.control_height || height < t.control_height {
+        return;
+    }
+    let card = ui_kit::Container::navigation_card(
+        ui.ctx(),
+        egui::Id::new("sc_render_interactive_controls"),
+        bounds.left_top(),
+        egui::Align2::LEFT_TOP,
+        |ui| {
+            ui.set_width(width);
+            ui.set_max_width(width);
+            ui.set_clip_rect(ui.clip_rect().intersect(bounds));
+            egui::ScrollArea::vertical()
+                .id_salt("sc_render_interactive_controls_scroll")
+                .min_scrolled_height(0.0)
+                .max_height(height)
+                .auto_shrink([false, true])
+                .show(ui, |ui| controls(app, ui));
+        },
+    );
+    crate::shell::register_panel(app, "render:interactive-card", Some(card.response.rect.intersect(bounds)), None);
+    crate::scenario::publish_rect("render:interactive-card", card.response.rect.intersect(bounds));
+}
+pub(super) fn controls(app: &mut SolveApp, ui: &mut egui::Ui) {
+    let state = &app.render_workspace.interactive;
+    let phase = state.phase;
+    let running = state.context.is_some();
+    let paused = state.user_paused;
+    let key = match phase {
+        Phase::Off => "render.interactive_off",
+        Phase::Updating => "render.interactive_updating",
+        Phase::Refining => "render.interactive_refining",
+        Phase::Paused => "render.interactive_paused",
+        Phase::TargetReached => "render.interactive_target",
+        Phase::Error => "render.interactive_error",
+    };
+    let label = app.tr(key).to_string();
+    let error = state.error.clone();
+    let samples = state.frame.as_ref().map(|frame| frame.samples);
+    let dimensions = state.frame.as_ref().map(|frame| (frame.info.width, frame.info.height));
+    let stale = state.frame.as_ref().is_some_and(|frame| frame.stale);
+    let final_active = state.final_active;
+    ui_kit::text(ui, &label, ui_kit::Text::Inline);
+    if running {
+        ui_kit::text(ui, app.tr("render.interactive_provisional"), ui_kit::Text::Note("render.interactive_provisional"));
+    }
+    if let Some(samples) = samples {
+        let label = crate::i18n::format("render.interactive_samples", &[("done", &samples.to_string()), ("total", "16")]);
+        ui_kit::text(ui, &label, ui_kit::Text::Inline);
+    }
+    if let Some((width, height)) = dimensions {
+        ui_kit::text(ui, &format!("{width} × {height} px"), ui_kit::Text::Inline);
+    }
+    if stale {
+        ui_kit::text(ui, app.tr("render.interactive_stale"), ui_kit::Text::Note("render.interactive_stale"));
+    }
+    if final_active {
+        ui_kit::text(ui, app.tr("render.interactive_final_active"), ui_kit::Text::Note("render.interactive_final_active"));
+    }
+    if let Some(error) = error {
+        ui_kit::text(ui, &error, ui_kit::Text::Error("render.interactive_error"));
+    }
+    let reason = ready(app).err();
+    if let Some(reason) = &reason {
+        ui_kit::text(ui, reason, ui_kit::Text::Note("render.interactive_requires_cpu"));
+    }
+    let mut action = None;
+    ui.horizontal_wrapped(|ui| {
+        for (action_value, name, key, enabled) in if !running {
+            vec![(Action::On, "on", "render.interactive_on", reason.is_none())]
+        } else {
+            vec![
+                (
+                    if paused || phase == Phase::Error { Action::Resume } else { Action::Pause },
+                    if paused || phase == Phase::Error { "resume" } else { "pause" },
+                    if paused || phase == Phase::Error { "render.interactive_resume" } else { "render.interactive_pause" },
+                    !final_active && (reason.is_none() || !(paused || phase == Phase::Error)),
+                ),
+                (Action::Off, "off", "render.interactive_off", true),
+            ]
+        } {
+            let label = app.tr(key).to_string();
+            let response = ui_kit::button(ui, label, ui_kit::Button::Enabled(enabled));
+            crate::scenario::publish_target(&format!("render:interactive:{name}"), response.rect);
+            if response.clicked() {
+                action = Some(action_value);
+            }
+        }
+    });
+    if let Some(action) = action {
+        if let Err(error) = app.run("render.interactive", json!({"action":action})) {
+            app.set_status(error, true);
+        }
+        ui.ctx().request_repaint();
+    }
+}
+pub(super) fn command_ready(app: &SolveApp) -> Result<(), String> {
+    if app.render_workspace.interactive.context.is_some() { Ok(()) } else { ready(app) }
+}
+pub(super) fn activate(app: &mut SolveApp) {
+    let state = &app.render_workspace.interactive;
+    let action = if state.context.is_none() {
+        Action::On
+    } else if state.user_paused || state.phase == Phase::Error {
+        Action::Resume
+    } else {
+        Action::Pause
+    };
+    if let Err(error) = app.run("render.interactive", json!({"action":action})) {
+        app.set_status(error, true);
+    }
+}
+pub(super) fn inspect(app: &SolveApp) -> Value {
+    let state = &app.render_workspace.interactive;
+    json!({"enabled":state.context.is_some(),"phase":format!("{:?}",state.phase),"visual_revision":state.visual,
+        "pending_capture":state.pending.is_some(),"paused":state.user_paused,"error":state.error,
+        "samples":state.frame.as_ref().map(|frame| frame.samples),"stale":state.frame.as_ref().is_some_and(|frame|frame.stale),
+        "job":state.frame.as_ref().map(|frame|frame.info.job),"provisional":true})
+}
