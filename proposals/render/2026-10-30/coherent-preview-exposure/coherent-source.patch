+                assert_eq!(image.get_pixel(0, 0).0, expected, "EV={ev}, progressive={progressive}, spatial={primary_samples}");
+                assert_eq!(image.get_pixel(1, 0).0, [0, 0, 0, 255]);
+                if final_frame { completed = true; break; }
+            }
