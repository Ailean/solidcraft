+fn partial_png_contract_info(png: &[u8]) -> solidcraft_engine::render::job::PartialPreviewInfo {
+    use sha2::{Digest, Sha256};
+    use solidcraft_engine::render::{ExecutorId, job::{AlphaConvention, ColourEncoding, FrameInfo, JobId, PartialPreviewInfo, PartialPreviewProjection}};
+    // Synthetic descriptor for pure contract tests. No Host/JobHandle, capture,
+    // native executor or final registry is installed or claimed by this helper.
+    PartialPreviewInfo {
+        frame: FrameInfo {
+            job: JobId { session: 100, serial: 1, generation: 1 }, scene_generation: 7,
+            backend: solidcraft_engine::render::builtin_backend().id,
+            executor: ExecutorId::new("cpu-raytrace").unwrap(),
+            width: 2, height: 2, encoding: ColourEncoding::Srgb, alpha: AlphaConvention::Straight,
+            png_bytes: png.len() as u64, png_sha256: format!("{:x}", Sha256::digest(png)),
+        },
+        sequence: 1, source_width: 2, source_height: 2, completed_passes: 0, updated_prefix: 3,
+        projection: PartialPreviewProjection::TopLeftRepresentativeV1,
+    }
+}
