+    // Plane z=x/2, index matched: thickness/cos(theta)=sqrt(5)/2 mm.
+    let distance=5.0_f64.sqrt()/2.0;
+    direct_rgb(direct_complete(&source,&options,ray),Vec3::new(2.0_f64.powf(-distance),4.0_f64.powf(-distance),1.0));
