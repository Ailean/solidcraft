+    let used = work.used();
+    cancel.cancel();
+    assert!(matches!(cursor.step(&mut work,&cancel),Err(super::super::TraceError::Cancelled)));
+    assert_eq!(work.used(),used);
+    assert!(cursor.step(&mut work,&cancel).is_err());
