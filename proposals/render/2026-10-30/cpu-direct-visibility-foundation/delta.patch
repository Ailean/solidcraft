+    // Existing incoherent sheet closure sums its virtual internal returns: (1-R)/(1+R)=12/13.
+    direct_rgb(direct_complete(&sheet, &options, direct_ray(10.0)), Vec3::new(12.0/13.0, 12.0/13.0, 12.0/13.0));
+}
