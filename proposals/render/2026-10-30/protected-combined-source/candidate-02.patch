+    #[test]
+    fn cancellation_during_real_partial_hash_closes_slots_and_publishes_nothing() {
+        let host = ImageHost(Arc::new(Owner { executor: None, shared: CpuHost::shared(MEMORY_LIMIT),
+            kind: HostKind::NativeWorker, running: Mutex::new(None), _worker: None }));
+        let request = ImageRequest { integrator: Integrator::Raytrace, raytrace: Some(RaytraceOptions {
+            progressive: Some(CpuProgressiveOptions { samples_per_pixel: 5, seed: 7 }), lights: Some(Vec::new()), ..Default::default()
+        }), width: 8, height: 8, ..request() };
+        let job = host.submit_cpu_partial_with_environment_and_options(id(7725, 1), 19, empty(), request, JobOptions::default(), None).unwrap();
+        let work = host.0.shared.queue.lock().unwrap().pop_front().unwrap();
+        let mut running = Running::begin(work).unwrap();
