--- a/crates/render/src/job/image_tests.rs
+++ b/crates/render/src/job/image_tests.rs
@@ -275,3 +275,129 @@
     let image = image::load_from_memory(&muted).unwrap().to_rgba8();
     assert!(image.pixels().any(|pixel| pixel.0 == [0, 0, 0, 255]));
