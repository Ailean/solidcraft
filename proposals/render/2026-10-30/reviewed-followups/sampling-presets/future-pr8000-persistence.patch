+#[test]
+fn both_sampling_gui_routes_refuse_a_missing_numerical_draft_without_mutation_or_command() {
+    for route in [SamplingGuiRoute::StageBar, SamplingGuiRoute::Inspector] {
+        let mut h = sampling_gui_fixture(ImageMethod::GpuRaytrace, false);
+        sampling_gui_frame(&mut h, route, vec![]);
+        h.app.render_workspace.view.studio.environment = studio::Environment::Hdr;
+        h.app.render_workspace.view.dirty = true;
+        h.app.render_workspace.view.inspector.quality_review = Some(json!({"original":"uninspected HDR advisory"}));
+        assert!(setups::draft(&h.app).is_err());
+        assert!(validate_sampling_preset(&h.app, SamplingPreset::High).is_ok());
+        let view = format!("{:?}", h.app.render_workspace.view);
+        let document = h.app.session.doc.clone();
+        let history = (h.app.session.revision, h.app.session.undo.len(), h.app.session.redo.len(), h.app.session.is_dirty());
+        sampling_gui_click(&mut h, route, "render:quality:high");
+        assert_eq!(format!("{:?}", h.app.render_workspace.view), view, "missing before draft must disable the actual preset for {route:?}");
+        assert!(Arc::ptr_eq(&document, &h.app.session.doc));
+        assert_eq!(history, (h.app.session.revision, h.app.session.undo.len(), h.app.session.redo.len(), h.app.session.is_dirty()));
+    }
