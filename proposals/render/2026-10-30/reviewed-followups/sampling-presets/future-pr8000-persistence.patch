+#[test]
+fn both_sampling_gui_routes_rollback_failed_persistence_including_advisory_and_dirty_state() {
+    for route in [SamplingGuiRoute::StageBar, SamplingGuiRoute::Inspector] {
+        let mut h = sampling_gui_fixture(ImageMethod::GpuRaytrace, false);
+        sampling_gui_frame(&mut h, route, vec![]);
+        // Affected sampling validation succeeds, but existing full setup
+        // validation must refuse depth zero. Do not make the oracle fit it.
+        h.app.render_workspace.view.max_depth = 0;
+        h.app.render_workspace.view.dirty = true;
+        h.app.render_workspace.view.inspector.quality_review = Some(json!({"original":"keep failed advisory"}));
+        assert!(validate_sampling_preset(&h.app, SamplingPreset::High).is_ok());
+        assert!(setups::draft(&h.app).unwrap().validate().is_err());
+        let view = format!("{:?}", h.app.render_workspace.view);
+        let document = h.app.session.doc.clone();
+        let history = (h.app.session.revision, h.app.session.undo.len(), h.app.session.redo.len(), h.app.session.is_dirty());
+        let revision = h.app.render_workspace.revision;
+        sampling_gui_click(&mut h, route, "render:quality:high");
+        assert_eq!(format!("{:?}", h.app.render_workspace.view), view, "rollback must retain all fields/report for {route:?}");
+        assert!(Arc::ptr_eq(&document, &h.app.session.doc));
+        assert_eq!(history, (h.app.session.revision, h.app.session.undo.len(), h.app.session.redo.len(), h.app.session.is_dirty()));
+        assert_eq!(h.app.render_workspace.revision, revision);
+        assert!(h.app.status.is_some(), "the actual caller must report the persistence failure");
+    }
+}
