+#[test]
+fn both_sampling_gui_routes_persist_one_undo_preserve_other_fields_and_survive_shot_switch() {
+    for route in [SamplingGuiRoute::StageBar, SamplingGuiRoute::Inspector] {
+        for (method, progressive) in [(ImageMethod::CpuRaytrace, false), (ImageMethod::CpuRaytrace, true), (ImageMethod::GpuRaytrace, false)] {
+            let mut h = sampling_gui_fixture(method, progressive);
+            sampling_gui_frame(&mut h, route, vec![]);
+            let name = h.app.render_workspace.view.name.clone();
+            let document = h.app.session.doc.to_json();
+            let original = h.app.session.doc.render.setups[&name].clone();
+            let other = h.app.session.doc.render.setups["Other sampling shot"].clone();
+            let camera = h.app.cam;
+            let undo = h.app.session.undo.len();
+            h.app.render_workspace.view.inspector.quality_review = Some(json!({"original":"advisory to clear only on commit"}));
+            sampling_gui_click(&mut h, route, "render:quality:high");
+            let mut expected = json!(original);
+            let samples = if method == ImageMethod::GpuRaytrace { 256 } else if progressive { 64 } else { 16 };
+            if method == ImageMethod::GpuRaytrace {
+                expected["job"]["options"]["samples"] = json!(samples);
+            } else if progressive {
+                expected["job"]["options"]["progressive"]["samples_per_pixel"] = json!(samples);
+            } else {
+                expected["job"]["options"]["primary_samples"] = json!(samples);
+            }
+            assert_eq!(json!(h.app.session.doc.render.setups[&name]), expected, "{route:?} {method:?} progressive={progressive}");
+            assert_eq!(h.app.session.undo.len(), undo + 1, "one command, including Inspector's existing wrapper");
+            assert_eq!(h.app.session.doc.render.setups["Other sampling shot"], other);
+            assert_eq!(h.app.cam, camera);
+            assert!(h.app.render_workspace.view.inspector.quality_review.is_none());
+            assert!(!h.app.render_workspace.view.dirty);
+            assert!(h.app.render_workspace.view.job.is_none() && h.app.render_workspace.view.completed.is_none());
+            switch_shot(&mut h.app, "Other sampling shot".into());
+            switch_shot(&mut h.app, name.clone());
+            assert_eq!(selected_sampling_preset(&h.app), Some(2));
+            assert_eq!(json!(h.app.session.doc.render.setups[&name]), expected);
+            assert_eq!(h.app.session.undo.len(), undo + 1, "switching shots must not hide a second persistence command");
+            h.app.run("edit.undo", json!({})).unwrap();
+            assert_eq!(h.app.session.doc.to_json(), document, "one Undo restores the complete saved document");
+            setups::load(&mut h.app);
+            assert_eq!(setups::draft(&h.app).unwrap(), original);
+        }
+    }
+}
