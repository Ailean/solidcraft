+// Original persistence regressions. These feed egui events through the real
+// stage-bar or inspector-panel call chain, not a replacement persistence shim.
+// No native window, renderer, capture or runtime qualification is implied.
+#[derive(Clone, Copy, Debug)]
+enum SamplingGuiRoute {
+    StageBar,
+    Inspector,
+}
+
+fn sampling_gui_frame(h: &mut Harness, route: SamplingGuiRoute, events: Vec<egui::Event>) {
+    crate::scenario::clear_handles();
+    let mut output = h.ctx.run_ui(
+        egui::RawInput {
+            screen_rect: Some(egui::Rect::from_min_size(egui::Pos2::ZERO, egui::vec2(1440.0, 1600.0))),
+            focused: true,
+            events,
+            ..Default::default()
+        },
+        |ui| match route {
+            SamplingGuiRoute::StageBar => {
+                let card = egui::Rect::from_min_size(egui::pos2(8.0, 8.0), egui::vec2(1400.0, ui_kit::StageBar::HEIGHT));
+                crate::render_ui::stage_bar(&mut h.app, ui, card);
+            }
+            SamplingGuiRoute::Inspector => super::super::panel(&mut h.app, ui),
+        },
+    );
+    output.textures_delta.clear();
+}
+
+fn sampling_gui_click(h: &mut Harness, route: SamplingGuiRoute, target: &str) {
+    sampling_gui_frame(h, route, vec![]);
+    let at = crate::scenario::rect_of(target).unwrap().center();
+    for pressed in [true, false] {
+        sampling_gui_frame(h, route, vec![egui::Event::PointerMoved(at), egui::Event::PointerButton {
+            pos: at, button: egui::PointerButton::Primary, pressed, modifiers: egui::Modifiers::NONE,
+        }]);
+    }
+    sampling_gui_frame(h, route, vec![]);
+}
+
+fn sampling_gui_fixture(method: ImageMethod, progressive: bool) -> Harness {
+    use solidcraft_engine::render::job::{CpuBudget, CpuProgressiveOptions};
+    let mut h = fixture();
+    h.app.render_workspace.view.method = method;
+    h.app.render_workspace.view.draft.width = 320;
+    h.app.render_workspace.view.draft.height = 200;
+    h.app.render_workspace.view.samples = 80; // Custom; High must be an actual change.
+    h.app.render_workspace.view.max_depth = 12;
+    h.app.render_workspace.view.seed = 817;
+    h.app.render_workspace.view.raytrace.budget = CpuBudget::Studio;
+    h.app.render_workspace.view.raytrace.progressive = progressive.then_some(CpuProgressiveOptions { samples_per_pixel: 7, seed: 491 });
+    setups::save(&mut h.app).unwrap();
+    let current = h.app.render_workspace.view.name.clone();
+    let other = h.app.session.doc.render.setups[&current].clone();
+    h.app.run("render.settings.set", json!({"name":"Other sampling shot","set":other})).unwrap();
+    setups::load(&mut h.app);
+    h.app.run("view.render_select", json!({"kind":"sampling"})).unwrap();
+    h.app.run("view.render_inspector", json!({"visible":true})).unwrap();
+    h
+}
