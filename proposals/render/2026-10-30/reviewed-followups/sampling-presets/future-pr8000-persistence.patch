+// The stage bar is outside the inspector panel's persistence transaction.
+// Wrap only this control here; the Sampling inspector already owns its one
+// persist_editor call and rollback. Size/format keep their existing ownership.
+fn stage_quality_choices(app: &mut SolveApp, ui: &mut egui::Ui) {
+    let before = setups::draft(app).ok();
+    let rollback = app.render_workspace.view.clone();
+    quality_choices(app, ui);
+    if let Some(before) = before
+        && let Err(error) = setups::persist_editor(app, &before)
+    {
+        app.render_workspace.view = rollback;
+        app.set_status(error, true);
+    }
+}
