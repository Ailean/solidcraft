+fn sampling_preset_frame(h: &mut Harness, events: Vec<egui::Event>) {
+    let mut output = h.ctx.run_ui(
+        egui::RawInput { screen_rect: Some(egui::Rect::from_min_size(egui::Pos2::ZERO, egui::vec2(600.0, 200.0))), events, ..Default::default() },
+        |ui| quality_choices(&mut h.app, ui),
+    );
+    output.textures_delta.clear();
+}
