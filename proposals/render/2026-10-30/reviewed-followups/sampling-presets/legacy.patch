+// Sampling-only choices. These do not select a renderer or a resource envelope.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum SamplingPreset {
+    Draft,
+    Balanced,
+    High,
+}
+impl SamplingPreset {
+    const ALL: [Self; 3] = [Self::Draft, Self::Balanced, Self::High];
+
+    fn fixed_cpu_samples(self) -> u8 {
+        match self {
+            Self::Draft => 1,
+            Self::Balanced => 4,
+            Self::High => 16,
+        }
+    }
+    fn progressive_cpu_samples(self) -> u32 {
+        match self {
+            Self::Draft => 4,
+            Self::Balanced => 16,
+            Self::High => 64,
+        }
+    }
+    fn gpu_samples(self) -> u32 {
+        match self {
+            Self::Draft => 16,
+            Self::Balanced => 64,
+            Self::High => 256,
+        }
+    }
+}
+
+/// Pure affected-field validation. Full capture, capability, work and memory
+/// admission still belong to the existing Check/Start path, never to a preset.
+fn validate_sampling_preset(app: &SolveApp, preset: SamplingPreset) -> Result<(), String> {
+    let view = &app.render_workspace.view;
+    match view.method {
+        ImageMethod::Raster => Err(app.tr("render.sampling_preset_raster").to_owned()),
+        ImageMethod::CpuRaytrace => {
+            let mut options = view.raytrace.clone();
+            if let Some(progressive) = &mut options.progressive {
+                progressive.samples_per_pixel = preset.progressive_cpu_samples();
+            } else {
+                options.primary_samples = preset.fixed_cpu_samples();
+            }
+            options.validate().map_err(|error| error.to_string())?;
+            options.budget.validate_image(view.draft.width, view.draft.height, options.progressive)
+                .map_err(|error| error.to_string())
+        }
+        ImageMethod::GpuRaytrace => {
+            // These three bounded values satisfy JobOptions' samples range.
+            // Adaptive minimum/pilot/error intent is retained, not adjusted to
+            // force a smaller maximum to fit. No resource or scene is captured.
+            if let Some(adaptive) = view.studio.adaptive {
+                adaptive.validate(preset.gpu_samples()).map_err(|error| error.to_string())?;
+            }
+            Ok(())
+        }
+    }
+}
+
+fn apply_sampling_preset(app: &mut SolveApp, preset: SamplingPreset) -> Result<(), String> {
+    validate_sampling_preset(app, preset)?;
+    match app.render_workspace.view.method {
+        ImageMethod::Raster => return Err(app.tr("render.sampling_preset_raster").to_owned()),
+        ImageMethod::CpuRaytrace => {
+            let options = &mut app.render_workspace.view.raytrace;
+            if let Some(progressive) = &mut options.progressive {
+                progressive.samples_per_pixel = preset.progressive_cpu_samples();
+            } else {
+                options.primary_samples = preset.fixed_cpu_samples();
+            }
+        }
+        ImageMethod::GpuRaytrace => app.render_workspace.view.samples = preset.gpu_samples(),
+    }
+    app.render_workspace.view.dirty = true;
+    Ok(())
+}
+
+fn selected_sampling_preset(app: &SolveApp) -> Option<usize> {
+    let view = &app.render_workspace.view;
+    SamplingPreset::ALL.into_iter().position(|preset| match view.method {
+        ImageMethod::Raster => false,
+        ImageMethod::CpuRaytrace => view.raytrace.progressive.map_or_else(
+            || view.raytrace.primary_samples == preset.fixed_cpu_samples(),
+            |options| options.samples_per_pixel == preset.progressive_cpu_samples(),
+        ),
+        ImageMethod::GpuRaytrace => view.samples == preset.gpu_samples(),
+    })
+}
