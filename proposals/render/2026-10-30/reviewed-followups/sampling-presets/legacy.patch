+fn sampling_preset_click(h: &mut Harness, target: &str) {
+    let at = crate::scenario::rect_of(target).unwrap().center();
+    for pressed in [true, false] {
+        sampling_preset_frame(h, vec![egui::Event::PointerMoved(at), egui::Event::PointerButton {
+            pos: at, button: egui::PointerButton::Primary, pressed, modifiers: egui::Modifiers::NONE,
+        }]);
+    }
+    sampling_preset_frame(h, vec![]);
+}
