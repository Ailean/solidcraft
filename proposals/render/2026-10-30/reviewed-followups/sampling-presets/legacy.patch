+fn sampling_preset_refusal_is_atomic_for_existing_cpu_envelopes_and_adaptive_minimum() {
+    use solidcraft_engine::render::job::{CpuBudget, CpuProgressiveOptions, adaptive::AdaptiveSampling};
+    let mut h = sampling_preset_fixture(ImageMethod::CpuRaytrace);
+    h.app.render_workspace.view.raytrace.budget = CpuBudget::Compact;
+    h.app.render_workspace.view.raytrace.progressive = Some(CpuProgressiveOptions { samples_per_pixel: 4, seed: 77 });
+    h.app.render_workspace.view.draft.width = 1024;
+    h.app.render_workspace.view.draft.height = 1024;
+    h.app.render_workspace.view.dirty = false;
+    let original = json!(h.app.render_workspace.view.raytrace);
+    assert!(apply_sampling_preset(&mut h.app, SamplingPreset::High).is_err());
+    assert_eq!(json!(h.app.render_workspace.view.raytrace), original);
+    assert!(!h.app.render_workspace.view.dirty);
+    assert_eq!((h.app.render_workspace.view.draft.width, h.app.render_workspace.view.draft.height), (1024, 1024));
+    h.app.render_workspace.view.method = ImageMethod::GpuRaytrace;
+    h.app.render_workspace.view.samples = 256;
+    h.app.render_workspace.view.studio.adaptive = Some(AdaptiveSampling { min_samples: 128, ..Default::default() });
+    let adaptive = h.app.render_workspace.view.studio.adaptive;
+    assert!(apply_sampling_preset(&mut h.app, SamplingPreset::Draft).is_err());
+    assert_eq!(h.app.render_workspace.view.samples, 256);
+    assert_eq!(h.app.render_workspace.view.studio.adaptive, adaptive);
+    assert!(!h.app.render_workspace.view.dirty);
