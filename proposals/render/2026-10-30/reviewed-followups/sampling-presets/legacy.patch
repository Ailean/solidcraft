+#[test]
+fn fixed_cpu_sampling_presets_change_only_primary_aa_and_preserve_optical_and_hdr_intent() {
+    use solidcraft_engine::render::job::{CpuBudget, DielectricBoundary, DielectricOptions, ReflectionBody, ReflectionMode, ReflectionOptions};
+    let mut h = sampling_preset_fixture(ImageMethod::CpuRaytrace);
+    h.app.render_workspace.view.raytrace.budget = CpuBudget::Studio;
+    h.app.render_workspace.view.raytrace.dielectrics.push(DielectricOptions {
+        body_index: 0, body_name: "Original optics".into(), boundary: DielectricBoundary::ClosedBox,
+        ior: 1.5, absorption_per_mm: [0.01, 0.02, 0.03], thickness_mm: 0.0,
+    });
+    h.app.render_workspace.view.raytrace.reflections = Some(ReflectionOptions {
+        bodies: vec![ReflectionBody { body: "Separate reflector".into(), mode: ReflectionMode::RoughSpecular }],
+        samples: 8, max_bounces: 3,
+    });
+    h.app.render_workspace.view.cpu.environment = cpu::Environment::Hdr;
+    h.app.render_workspace.view.cpu.rotation_rad = 0.75;
+    h.app.render_workspace.view.cpu.intensity = 2.0;
+    h.app.render_workspace.view.cpu.samples = 64;
+    // HDR deliberately remains uninspected: a sampling choice neither reads
+    // the file nor claims the whole optical/HDR request has been admitted.
+    let before_cpu = format!("{:?}", h.app.render_workspace.view.cpu);
+    let before_settings = json!(h.app.render_workspace.view.draft);
+    let camera = h.app.cam;
+    let document = h.app.session.doc.clone();
+    let history = (h.app.session.revision, h.app.session.undo.len(), h.app.session.is_dirty());
+    let original = json!(h.app.render_workspace.view.raytrace);
+    for (preset, samples) in [(SamplingPreset::Draft, 1), (SamplingPreset::Balanced, 4), (SamplingPreset::High, 16)] {
+        apply_sampling_preset(&mut h.app, preset).unwrap();
+        let mut expected = original.clone();
+        expected["primary_samples"] = json!(samples);
+        assert_eq!(json!(h.app.render_workspace.view.raytrace), expected);
+        assert!(h.app.render_workspace.view.raytrace.progressive.is_none());
+        assert_eq!(format!("{:?}", h.app.render_workspace.view.cpu), before_cpu);
+        assert_eq!(json!(h.app.render_workspace.view.draft), before_settings);
+        assert_eq!(h.app.render_workspace.view.method, ImageMethod::CpuRaytrace);
+        assert_eq!(h.app.cam, camera);
+    }
+    assert!(Arc::ptr_eq(&document, &h.app.session.doc));
+    assert_eq!(history, (h.app.session.revision, h.app.session.undo.len(), h.app.session.is_dirty()));
+    assert!(h.app.render_workspace.view.job.is_none() && h.app.render_workspace.view.completed.is_none());
+}
