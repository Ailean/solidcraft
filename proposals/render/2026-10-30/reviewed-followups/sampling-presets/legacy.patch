+#[test]
+fn original_quality_segments_apply_sampling_and_custom_keeps_its_existing_navigation_action() {
+    let mut h = sampling_preset_fixture(ImageMethod::CpuRaytrace);
+    sampling_preset_frame(&mut h, vec![]);
+    sampling_preset_click(&mut h, "render:quality:balanced");
+    assert_eq!(h.app.render_workspace.view.raytrace.primary_samples, 4);
+    sampling_preset_click(&mut h, "render:quality:high");
+    assert_eq!(h.app.render_workspace.view.raytrace.primary_samples, 16);
+    sampling_preset_click(&mut h, "render:quality:custom");
+    assert_eq!(h.app.render_workspace.view.selection, super::super::RenderSelection::Sampling);
+    assert_eq!(h.app.render_workspace.view.raytrace.primary_samples, 16);
+    assert!(h.app.render_workspace.view.job.is_none() && h.app.render_workspace.view.completed.is_none());
+}
