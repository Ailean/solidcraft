+#[test]
+fn gpu_presets_only_change_sample_cap_and_keep_adaptive_effects_lights_hdr_and_depth() {
+    use solidcraft_engine::render::job::{JobOptions, adaptive::AdaptiveSampling};
+    let mut h = sampling_preset_fixture(ImageMethod::GpuRaytrace);
+    h.app.render_workspace.view.max_depth = 12;
+    h.app.render_workspace.view.seed = 817;
+    h.app.render_workspace.view.draft.exposure_ev = 1.25;
+    h.app.render_workspace.view.studio.adaptive = Some(AdaptiveSampling { min_samples: 16, relative_error: 0.03, ..Default::default() });
+    h.app.render_workspace.view.studio.denoise = true;
+    h.app.render_workspace.view.studio.linear_exr = true;
+    h.app.render_workspace.view.studio.transmission_samples = 4;
+    h.app.render_workspace.view.studio.environment = studio::Environment::Hdr;
+    h.app.render_workspace.view.studio.rotation_rad = 0.8;
+    let studio_before = format!("{:?}", h.app.render_workspace.view.studio);
+    let settings = json!(h.app.render_workspace.view.draft);
+    let camera = h.app.cam;
+    for (preset, samples) in [(SamplingPreset::Draft, 16), (SamplingPreset::Balanced, 64), (SamplingPreset::High, 256)] {
+        // Independent API bound: each proposed cap is a real supported sample
+        // value, not an alias for a profile, dimension or denoiser change.
+        JobOptions { samples, ..Default::default() }.validate().unwrap();
+        apply_sampling_preset(&mut h.app, preset).unwrap();
+        assert_eq!(h.app.render_workspace.view.samples, samples);
+        assert_eq!((h.app.render_workspace.view.max_depth, h.app.render_workspace.view.seed), (12, 817));
+        assert_eq!(format!("{:?}", h.app.render_workspace.view.studio), studio_before);
+        assert_eq!(json!(h.app.render_workspace.view.draft), settings);
+        assert_eq!(h.app.render_workspace.view.method, ImageMethod::GpuRaytrace);
+        assert_eq!(h.app.cam, camera);
+    }
+}
