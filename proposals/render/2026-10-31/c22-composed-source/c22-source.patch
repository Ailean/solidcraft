+    assert!(matches!(owner.begin(direct_ray(10.0), 2, &mut work, &cancel), Err(super::super::TraceError::WorkLimit)));
+    assert_eq!(work.used(), used);
+    assert!(owner.step(&mut work, &cancel).is_err());
+    assert_eq!(work.used(), used);
+}
