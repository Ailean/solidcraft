-            path: OpticalPath { ray, throughput: Vec3::new(1.0, 1.0, 1.0), medium: None, segment_start: ray.origin(), boundaries: 0, bounce: 0 },
-            camera_sample: None,
-            stack: [None; MAX_BOUNDARIES as usize + 1],
-            stack_len: 0,
-            paths: 1,
