+            disabled_reasons: &[quality_reason(app, 0), quality_reason(app, 1), quality_reason(app, 2), None],
+            ..Default::default()
+        },
+    ) && let Err(error) = choose_quality(app, quality) {
+        app.set_status(error, true);
+    }
+}
