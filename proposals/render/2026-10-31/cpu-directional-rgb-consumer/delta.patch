+fn original_box(ordinal: usize) -> crate::ProductMesh {
+    assert!(ordinal < 2);
+    let lo = if ordinal == 0 { 1.0 } else { 3.0 };
+    let hi = lo + 1.0;
+    crate::ProductMesh {
+        transmission: None,
+        name: format!("Original directional glass {ordinal}"),
+        mesh: Arc::new(Mesh {
+            positions: (0..8).map(|i| Vec3::new(
+                if i & 1 == 0 { -2.0 } else { 2.0 },
+                if i & 2 == 0 { -2.0 } else { 2.0 },
+                if i & 4 == 0 { lo } else { hi },
+            )).collect(),
+            // Outward winding of six closed rectangular faces, two triangles each.
+            triangles: vec![
+                [0, 2, 3], [0, 3, 1], [4, 5, 7], [4, 7, 6],
+                [0, 4, 6], [0, 6, 2], [1, 3, 7], [1, 7, 5],
+                [0, 1, 5], [0, 5, 4], [2, 6, 7], [2, 7, 3],
+            ],
+            ..Default::default()
+        }),
+        color: [255; 3],
+        opacity: 1.0,
+        surface: None,
+        faces: Vec::new(),
+    }
+}
