+// Original fixtures for consecutive CPU publication; WRITTEN, NOT RUN.
+#[cfg(all(feature = "raytrace-cpu", not(target_arch = "wasm32")))]
+mod every_cpu_pass {
+    use super::*;
+    use crate::job::{CpuBudget, CpuProgressiveOptions, RaytraceOptions};
+
+    enum Snapshot {
+        Complete(Arc<RenderPreview>),
+        Partial(Arc<RenderPartialPreview>),
+    }
+    impl Snapshot {
+        fn pass(&self) -> u32 {
+            match self {
+                Self::Complete(preview) => preview.info.samples_per_pixel,
+                Self::Partial(preview) => {
+                    assert_eq!(preview.info.updated_prefix, 0, "automatic publication is a uniform complete pass");
+                    preview.info.completed_passes
+                }
+            }
+        }
+        fn png(&self) -> &[u8] {
+            match self {
+                Self::Complete(preview) => preview.png(),
+                Self::Partial(preview) => preview.png(),
+            }
+        }
+        fn sequence(&self) -> u64 {
+            match self {
+                Self::Complete(preview) => u64::from(preview.info.frame_sequence),
+                Self::Partial(preview) => preview.info.sequence,
+            }
+        }
+    }
+    fn snapshot(job: &JobHandle, protected: bool) -> Option<Snapshot> {
+        if protected { job.partial_preview().unwrap().map(Snapshot::Partial) } else { job.preview().unwrap().map(Snapshot::Complete) }
+    }
+    fn fixture(samples: u32, protected: bool) -> (CpuHost, JobHandle, Running) {
+        let host = ImageHost(Arc::new(Owner {
+            executor: None,
+            shared: CpuHost::shared(MEMORY_LIMIT),
+            kind: HostKind::NativeWorker,
+            running: Mutex::new(None),
+            _worker: None,
+        }));
+        let request = ImageRequest {
+            integrator: Integrator::Raytrace,
+            raytrace: Some(RaytraceOptions {
+                budget: if samples > 64 { CpuBudget::Workstation } else { CpuBudget::Compact },
+                progressive: Some(CpuProgressiveOptions { samples_per_pixel: samples, seed: 123 }),
+                lights: Some(Vec::new()),
+                ..Default::default()
+            }),
+            width: 1,
+            height: 1,
+            background: [10, 20, 30],
+            ..request()
+        };
+        let job = if protected {
+            host.submit_cpu_protected_partial_with_environment_and_options(id(7790, 1), 19, empty(), request, JobOptions::default(), None)
+        } else {
+            host.submit(id(7790, 1), 19, empty(), request)
+        }
+        .unwrap();
+        let work = host.0.shared.queue.lock().unwrap().pop_front().unwrap();
+        let running = Running::begin(work).unwrap();
+        (host, job, running)
+    }
+    fn finish(running: &mut Running) {
+        for _ in 0..10_000_000 {
+            if !running.advance(16_384).unwrap() {
+                return;
+            }
+        }
+        panic!("one-pixel every-pass fixture exceeded its finite continuation bound");
+    }
+    fn run_all(samples: u32, protected: bool, quantum: usize) {
+        let (host, job, mut running) = fixture(samples, protected);
+        let admission = host.admitted_bytes();
+        let mut previous = 0;
+        let mut complete = false;
+        for _ in 0..10_000_000 {
+            let more = running.advance(quantum).unwrap();
+            if let Some(preview) = snapshot(&job, protected) {
+                let pass = preview.pass();
+                if pass != previous {
+                    assert_eq!(pass, previous + 1, "no missing, duplicate or reordered complete pass");
+                    assert!(pass < samples);
+                    match &preview {
+                        Snapshot::Complete(value) => {
+                            assert_eq!(value.info.frame_sequence, pass);
+                            assert_eq!(value.info.frame.job, job.id());
+                            assert_eq!(value.info.frame.scene_generation, 19);
+                        }
+                        Snapshot::Partial(value) => {
+                            assert_eq!(value.info.sequence, u64::from(pass));
+                            assert_eq!(value.info.frame.job, job.id());
+                            assert_eq!(value.info.frame.scene_generation, 19);
+                            assert_eq!(value.covered(), &[0]);
+                        }
+                    }
+                    assert_eq!(image::load_from_memory(preview.png()).unwrap().to_rgba8().get_pixel(0, 0).0, [10, 20, 30, 255]);
+                    assert!(job.frame().unwrap().is_none(), "a provisional pass is not a final image");
+                    previous = pass;
+                }
+            } // No retained consumer Arc and no UI acknowledgement.
+            assert!(host.admitted_bytes() <= admission, "publication recycles the same two prepaid slots");
+            if !more {
+                complete = true;
+                break;
+            }
+        }
+        assert!(complete);
+        assert_eq!(previous, samples - 1);
+        let status = job.status().unwrap();
+        assert_eq!(status.progress.phase, Phase::Completed);
+        assert_eq!(status.cpu_preview_retention_skips, 0);
+        assert_eq!(status.request.raytrace.as_ref().unwrap().progressive, Some(CpuProgressiveOptions { samples_per_pixel: samples, seed: 123 }));
+        assert!(job.preview().unwrap().is_none() && job.partial_preview().unwrap().is_none());
+        let frame = job.frame().unwrap().unwrap();
+        assert_eq!(image::load_from_memory(frame.png()).unwrap().to_rgba8().get_pixel(0, 0).0, [10, 20, 30, 255]);
+        if protected {
+            let report = job.protected_preview_report().unwrap().unwrap();
+            assert_eq!(report.accepted_snapshots, samples - 1);
+            assert_eq!(report.presentation_used, u64::from(samples - 1) * 65_552);
+        }
+        drop(frame);
+        drop(status);
+        drop(running);
+        drop(job);
+        assert_eq!(host.admitted_bytes(), 0);
+    }
+
+    #[test]
+    fn real_legacy_and_protected_hosts_publish_every_pass_without_ui_demand() {
+        for protected in [false, true] {
+            for quantum in [1, 16_384] {
+                for samples in [1, 7] {
+                    run_all(samples, protected, quantum);
+                }
+            }
+        }
+    }
+    #[test]
+    #[cfg(target_pointer_width = "64")]
+    fn real_one_pixel_high_target_crosses_64_with_constant_slots() {
+        for protected in [false, true] {
+            run_all(65, protected, 16_384);
+        }
+    }
+    #[test]
+    fn two_external_snapshots_are_diagnosed_without_waiting_or_losing_the_final() {
+        for protected in [false, true] {
+            let (host, job, mut running) = fixture(7, protected);
+            let mut held = Vec::new();
+            for _ in 0..100_000 {
+                assert!(running.advance(1).unwrap());
+                if let Some(preview) = snapshot(&job, protected) {
+                    if preview.pass() == held.len() as u32 + 1 {
+                        held.push(preview);
+                    }
+                }
+                if held.len() == 2 {
+                    break;
+                }
+            }
+            assert_eq!(held.len(), 2);
+            let hashes: Vec<_> = held.iter().map(|preview| Sha256::digest(preview.png())).collect();
+            finish(&mut running);
+            let status = job.status().unwrap();
+            assert_eq!(status.progress.phase, Phase::Completed);
+            assert_eq!(status.cpu_preview_retention_skips, 4, "passes 3,4,5,6 had both slots externally pinned");
+            assert!(job.frame().unwrap().is_some());
+            for (preview, hash) in held.iter().zip(hashes) {
+                assert_eq!(Sha256::digest(preview.png()), hash);
+            }
+            drop(running);
+            drop(status);
+            drop(job);
+            assert!(host.admitted_bytes() > 0, "external snapshots remain charged after their job drops");
+            drop(held);
+            assert_eq!(host.admitted_bytes(), 0);
+        }
