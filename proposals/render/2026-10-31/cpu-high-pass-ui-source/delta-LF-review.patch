+#[test]
+fn cpu_each_complete_pass_caches_its_real_png_without_promoting_a_provisional_to_final() {
+    use solidcraft_engine::render::job::{CpuHost, CpuProgressiveOptions};
+    let mut h = interactive_ui_fixture();
+    if !interactive_test_cpu_branch(&mut h, "cpu_each_complete_pass_caches_its_real_png_without_promoting_a_provisional_to_final") {
+        return;
+    }
+    let host = CpuHost::cooperative();
+    h.app.session.set_render_job_host(Some(host.clone())).unwrap();
+    h.app.render_workspace.view.draft.width = 1;
+    h.app.render_workspace.view.draft.height = 1;
+    h.app.render_workspace.view.raytrace.primary_samples = 1;
+    h.app.render_workspace.view.raytrace.progressive = Some(CpuProgressiveOptions { samples_per_pixel: 4, seed: 741 });
+    let wire = runtime_image_request(&h.app, false).unwrap();
+    let reply = h.app.session.execute("render.start", &wire).unwrap();
+    let job = serde_json::from_value(reply["job"].clone()).unwrap();
+    h.app.render_workspace.view.job = Some(job);
+    let handle = h.app.session.render_job_handle(job).unwrap();
+    let ctx = egui::Context::default();
+    for pass in 1..4 {
+        let publication = (0..100_000).find_map(|_| {
+            host.pump(1).unwrap();
+            assert!(handle.frame().unwrap().is_none(), "the final cannot overtake a required pass in single-unit cooperative stepping");
+            handle.preview().unwrap().filter(|preview| preview.info.samples_per_pixel == pass)
+        }).expect("every complete pass must publish a real renderer PNG when no external slots are held");
+        assert_eq!(publication.info.frame_sequence, pass);
+        assert_eq!(publication.info.frame.executor.as_str(), "cpu-raytrace");
+        let output = ctx.run_ui(egui::RawInput::default(), |ui| cache_preview_frame(&mut h.app, ui.ctx(), &publication.info, publication.png()));
+        let display = displayed_image(&h.app).unwrap();
+        assert!(display.provisional());
+        assert_eq!(display.preview.unwrap().samples_per_pixel, pass);
+        assert_eq!(display.info.png_sha256, publication.info.frame.png_sha256);
+        let png = image::load_from_memory_with_format(publication.png(), image::ImageFormat::Png).unwrap().to_rgba8();
+        let texture = display.image.as_ref().unwrap().id();
+        let egui::ImageData::Color(pixels) = &output.textures_delta.set.get(&texture).unwrap().first().unwrap().image;
+        assert_eq!(pixels.pixels.len(), png.pixels().len());
+        assert!(pixels.pixels.iter().zip(png.pixels()).all(|(actual, rgba)| *actual == Color32::from_rgba_unmultiplied(rgba[0], rgba[1], rgba[2], rgba[3])));
+        assert!(h.app.render_workspace.view.completed.is_none());
+        // Drop the actual publication before allowing the next pass to run.
+        drop(publication);
+    }
+    for _ in 0..100_000 {
+        if handle.frame().unwrap().is_some() { break; }
+        host.pump(1).unwrap();
+    }
+    assert!(handle.frame().unwrap().is_some());
+    cache_render_images(&mut h.app, &ctx);
+    assert_eq!(h.app.render_workspace.view.completed, Some(job));
+    assert!(!displayed_image(&h.app).unwrap().provisional());
+}
