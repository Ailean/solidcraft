+pub(super) struct PartialExpectation<'a> {
+    pub(super) job: JobId,
+    pub(super) scene_generation: u64,
+    pub(super) request: &'a solidcraft_engine::render::job::ImageRequest,
+    pub(super) final_dimensions: [u32; 2],
