+    work.charge(work.remaining(), &cancel).unwrap();
+    assert!(matches!(cursor.step(&mut work, &cancel), Err(super::super::TraceError::WorkLimit)));
+    assert!(cursor.step(&mut work, &cancel).is_err());
+    let cancel = CancelToken::default();
