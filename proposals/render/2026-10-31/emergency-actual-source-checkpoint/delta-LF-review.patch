+            eprintln!("MANUAL_FINAL_CPU_BRANCH case={case} cpu_supported=false unsupported_refusal_asserted=true");
+            return None;
+        }
+        eprintln!("MANUAL_FINAL_CPU_BRANCH case={case} cpu_supported=true");
+        Some(h)
+    }
