+    #[test]
+    fn release_after_a_pinned_pass_keeps_publication_sequence_separate_from_actual_spp() {
+        for protected in [false, true] {
+            let (host, job, mut running) = fixture(7, protected);
+            let mut held = Vec::new();
+            for _ in 0..100_000 {
+                assert!(running.advance(1).unwrap());
+                if let Some(preview) = snapshot(&job, protected) {
+                    if preview.pass() == held.len() as u32 + 1 {
+                        held.push(preview);
+                    }
+                }
+                if held.len() == 2 {
+                    break;
+                }
+            }
+            assert_eq!(held.len(), 2);
+            for _ in 0..100_000 {
+                if job.status().unwrap().cpu_preview_retention_skips == 1 {
+                    break;
+                }
+                assert!(running.advance(1).unwrap());
+            }
+            assert_eq!(job.status().unwrap().cpu_preview_retention_skips, 1);
+            drop(held.remove(0)); // Return exactly one old consumer slot after pass 3.
+            let mut fourth = None;
+            for _ in 0..100_000 {
+                assert!(running.advance(1).unwrap());
+                if let Some(preview) = snapshot(&job, protected) {
+                    if preview.pass() == 4 {
+                        fourth = Some(preview);
+                        break;
+                    }
+                }
+            }
+            let fourth = fourth.unwrap();
+            assert_eq!(fourth.pass(), 4);
+            assert_eq!(fourth.sequence(), 3, "SPP 3 was diagnosed, not published");
+            assert_eq!(job.status().unwrap().cpu_preview_retention_skips, 1);
+            drop(fourth);
+            finish(&mut running);
+            assert_eq!(job.status().unwrap().progress.phase, Phase::Completed);
+            assert_eq!(job.status().unwrap().cpu_preview_retention_skips, 1);
+            drop(running);
+            drop(job);
+            drop(held);
+            assert_eq!(host.admitted_bytes(), 0);
+        }
+    }
+    #[test]
+    fn cancellation_after_third_pass_and_last_digest_chunk_never_publishes_late() {
+        for protected in [false, true] {
+            let (host, job, mut running) = fixture(7, protected);
+            let mut held = None;
+            for _ in 0..100_000 {
+                assert!(running.advance(1).unwrap());
+                if let Some(preview) = snapshot(&job, protected) {
+                    if preview.pass() == 3 {
+                        held = Some(preview);
+                        break;
+                    }
+                }
+            }
+            let held = held.unwrap();
+            let hash = Sha256::digest(held.png());
+            for _ in 0..100_000 {
+                if running.pending_png.is_some() {
