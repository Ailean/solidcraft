+#[cfg(test)]
+mod directional_shadow_guard_tests {
+    use super::*;
+
+    fn wire() -> Value {
+        json!({"integrator":"raytrace","settings":{"width":1,"height":1,"job":null},
+            "raytrace":{"directional_shadow_transmission":true,"shadows":true,"lights":[],
+                "dielectrics":[{"body_index":0,"body_name":"guard-only target","boundary":"thin_sheet",
+                    "ior":1.0,"absorption_per_mm":[0.0,0.0,0.0],"thickness_mm":1.0}]}})
+    }
+
+    #[test]
+    fn interactive_lowering_preserves_real_directional_mode_without_selecting_it_by_default() {
+        for enabled in [false, true] {
+            let mut input = wire();
+            input["raytrace"]["directional_shadow_transmission"] = json!(enabled);
+            let lowered = interactive_params(&input).unwrap();
+            let after: Start = serde_json::from_value(lowered.clone()).unwrap();
+            assert_eq!(after.raytrace.unwrap().directional_shadow_transmission, enabled);
+            assert_eq!(lowered["raytrace"].get("directional_shadow_transmission").and_then(Value::as_bool), enabled.then_some(true));
+        }
+    }
+
+    #[cfg(all(feature = "raytrace-cpu", not(target_arch = "wasm32")))]
+    #[test]
+    fn directional_context_refusals_precede_unopened_hdr_and_product_capture() {
+        let mut session = Session::default();
+        let host = solidcraft_render::job::CpuHost::for_platform().unwrap();
+        session.set_render_job_host(Some(host)).unwrap();
+        for nested in [false, true] {
+            let mut input = wire();
+            if nested {
+                input["nested_media"] = json!(true);
+            } else {
+                input["environment"] = json!({"path":"must-not-open-original-directional.hdr","samples":4});
+            }
+            let error = prepare(&session, &input, "render.start").err().unwrap().to_string();
+            assert!(
+                error.contains(if nested {
+                    "directional shadow transmission does not support nested media"
+                } else {
+                    "directional shadow transmission does not support HDR environments"
+                }),
+                "{error}"
+            );
+            assert!(!error.contains("could not read"));
+            assert_eq!(session.render_job_host().unwrap().admitted_bytes(), 0);
+        }
+    }
+}
