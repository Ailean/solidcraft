+#[test]
+fn sparse_checkpoint_compatibility_preserves_each_final_png_and_deterministic_sample_prefix() {
+    for (target, expected_sparse) in [(1, vec![]), (3, vec![1, 2]), (5, vec![1, 2, 4]), (9, vec![1, 2, 4, 8])] {
+        let current = progressive_fixture(target, 19, Some(true), 1.0);
+        let source = current.visibility_owner.source().clone();
+        let options = current.visibility_owner.options().clone();
+        let mut legacy_request = current.request.clone();
+        legacy_request.cpu_progressive_every_pass = false;
+        let legacy = ImageTask::new(source, legacy_request, CancelToken::default(), options).unwrap();
+        let (each_previews, each_final, _) = progressive_complete(current, 1);
+        let (legacy_previews, legacy_final, _) = progressive_complete(legacy, 3);
+        assert_eq!(each_previews.iter().map(|(samples, _)| *samples).collect::<Vec<_>>(), (1..target).collect::<Vec<_>>());
+        assert_eq!(legacy_previews.iter().map(|(samples, _)| *samples).collect::<Vec<_>>(), expected_sparse);
+        assert_eq!(legacy_final, each_final, "publication policy must not change the requested final PNG");
+        for (samples, png) in legacy_previews {
+            assert_eq!(png, each_previews.iter().find(|(count, _)| *count == samples).unwrap().1);
+        }
+    }
