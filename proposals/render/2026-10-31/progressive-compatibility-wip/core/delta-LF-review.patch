+#[test]
+fn legacy_protected_producer_consumes_the_original_global_milestones_without_changing_final_pixels() {
+    let (scene, mut request, options) = partial_four_pixel_source(5, 29);
+    request.cpu_progressive_every_pass = false;
+    let reference = ImageTask::new(scene.clone(), request.clone(), CancelToken::default(), options.clone()).unwrap();
+    let (_, expected_png, _) = progressive_complete(reference, 3);
+    let plan = job::ProtectedPreviewPlan::with_cadence(request.width, request.height, 5, options.budget, false).unwrap();
+    assert_eq!((plan.total_commits(), plan.quota_limit()), (20, 19));
+    let mut task = ImageTask::new_with_environment_and_nested_and_protected_partial(
+        scene, request, CancelToken::default(), options, None, false, plan,
+    )
+    .unwrap();
+    let mut rays = Vec::new();
+    for committed in 1..20 {
+        reach_partial_frontier(&mut task, (committed / 4) as u32, (committed % 4) as usize, &mut rays);
+        assert!(matches!(task.begin_partial_preview(plan.preview_plan()).unwrap(), PartialBegin::Started));
+        let (_, _, passes, prefix) = finish_partial_snapshot(&mut task);
+        assert_eq!(u64::from(passes) * 4 + prefix, committed);
+        let report = task.protected_preview_report().unwrap();
+        assert_eq!((report.accepted_snapshots, report.next_milestone_index), (committed as u32, committed as u32));
+        assert_eq!(report.quota_limit, 19);
+    }
+    let (actual_png, _) = finish_partial_final(&mut task, true, &mut rays);
+    assert_eq!(actual_png, expected_png);
+    let report = task.protected_preview_report().unwrap();
+    assert_eq!((report.accepted_snapshots, report.quota_limit), (19, 19));
+    assert_eq!(report.presentation_used, 19 * plan.snapshot_work().unwrap());
+}
