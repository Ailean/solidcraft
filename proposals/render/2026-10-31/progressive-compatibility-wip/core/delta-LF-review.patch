+        assert_eq!(normalized.params["cpu_progressive_every_pass"], false);
+        assert!(normalized.params["settings"]["job"].is_null());
+        let prepared = prepare(&session, &replay, "render.preflight").unwrap();
+        assert!(!prepared.request.cpu_progressive_every_pass);
