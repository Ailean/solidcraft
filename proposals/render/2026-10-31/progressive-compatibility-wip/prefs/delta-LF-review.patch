+    fn cpu_progressive_policy_preferences_default_roundtrip_validate_and_reset_independently() {
+        let defaults = Prefs::default();
+        assert!(defaults.render_cpu_progressive_every_pass && defaults.render_cpu_interactive_explicit_sampling);
+        let omitted: Prefs = serde_json::from_value(json!({})).unwrap();
+        assert!(omitted.render_cpu_progressive_every_pass && omitted.render_cpu_interactive_explicit_sampling);
+        let mut app = SolveApp::new(Default::default(), Default::default());
+        let document = app.session.doc.clone();
+        let history = (app.session.revision, app.session.undo.len(), app.session.is_dirty());
+        for key in ["render_cpu_progressive_every_pass", "render_cpu_interactive_explicit_sampling"] {
+            let reply = super::set(&mut app, &json!({key:false})).unwrap();
+            assert_eq!(reply[key], false);
+            for invalid in [json!("false"), json!(0), json!(null), json!([])] {
+                assert!(super::set(&mut app, &json!({key:invalid})).is_err());
+                assert_eq!(serde_json::to_value(&app.preferences).unwrap()[key], false);
+            }
+        }
+        let mut restored = SolveApp::new(Default::default(), Default::default());
+        restored.load_prefs(&app.prefs());
+        assert!(!restored.preferences.render_cpu_progressive_every_pass && !restored.preferences.render_cpu_interactive_explicit_sampling);
+        super::defaults(&mut restored, super::PAGE_GENERAL);
+        assert!(!restored.preferences.render_cpu_progressive_every_pass && !restored.preferences.render_cpu_interactive_explicit_sampling);
+        let reply = super::set(&mut restored, &json!({"render_cpu_progressive_every_pass":true})).unwrap();
+        assert_eq!(reply["render_cpu_progressive_every_pass"], true);
+        assert_eq!(reply["render_cpu_interactive_explicit_sampling"], false);
+        super::defaults(&mut restored, super::PAGE_GRAPHICS);
+        assert!(restored.preferences.render_cpu_progressive_every_pass && restored.preferences.render_cpu_interactive_explicit_sampling);
+        assert!(std::sync::Arc::ptr_eq(&document, &app.session.doc));
+        assert_eq!(history, (app.session.revision, app.session.undo.len(), app.session.is_dirty()));
+    }
