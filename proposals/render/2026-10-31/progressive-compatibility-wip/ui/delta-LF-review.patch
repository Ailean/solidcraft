+#[test]
+fn cpu_capture_policy_preferences_preserve_typed_setup_final_intent_and_independent_sampling_copy() {
+    use solidcraft_engine::render::job::CpuProgressiveOptions;
+    let mut h = Harness::new();
+    h.app.render_workspace.view.method = ImageMethod::CpuRaytrace;
+    h.app.render_workspace.view.draft.width = 16;
+    h.app.render_workspace.view.draft.height = 16;
+    h.app.render_workspace.view.raytrace.primary_samples = 1;
+    h.app.render_workspace.view.raytrace.progressive = Some(CpuProgressiveOptions { samples_per_pixel: 31, seed: 741 });
+    let original_options = json!(h.app.render_workspace.view.raytrace);
+    let saved = setups::snapshot(&h.app).unwrap();
+    let document = h.app.session.doc.clone();
+    let history = (h.app.session.revision, h.app.session.undo.len(), h.app.session.is_dirty());
+    for each_pass in [true, false] {
+        for preserve_sampling in [true, false] {
+            h.app.preferences.render_cpu_progressive_every_pass = each_pass;
+            h.app.preferences.render_cpu_interactive_explicit_sampling = preserve_sampling;
+            let final_request = image_request(&h.app).unwrap();
+            assert_eq!(final_request["settings"], json!(saved), "portable settings.job stays intact");
+            assert!(final_request.get("raytrace").is_none(), "no contradictory parallel runtime CPU options");
+            assert_eq!(final_request.get("cpu_progressive_every_pass"), (!each_pass).then_some(&json!(false)));
+            let interactive = interactive_request(&h.app).unwrap();
+            assert_eq!(interactive["raytrace"]["progressive"]["samples_per_pixel"], if preserve_sampling { 31 } else { 16 });
+            assert_eq!(interactive["raytrace"]["progressive"]["seed"], if preserve_sampling { 741 } else { 0 });
+            assert_eq!(interactive.get("cpu_progressive_every_pass"), (!each_pass).then_some(&json!(false)));
+            assert_eq!(interactive["settings"]["width"], 16);
+            assert_eq!(interactive["settings"]["height"], 16);
+            let frozen_command = interactive.clone();
+            h.app.preferences.render_cpu_progressive_every_pass = !each_pass;
+            let later_command = interactive_request(&h.app).unwrap();
+            assert_ne!(frozen_command, later_command, "the exact Value identity carries the policy");
+            assert_eq!(frozen_command, interactive, "an issued command copy cannot follow a later preference edit");
+            h.app.preferences.render_cpu_progressive_every_pass = each_pass;
+            assert_eq!(json!(h.app.render_workspace.view.raytrace), original_options);
+            assert_eq!(setups::snapshot(&h.app).unwrap(), saved);
+        }
+    }
+    assert!(Arc::ptr_eq(&document, &h.app.session.doc));
+    assert_eq!(history, (h.app.session.revision, h.app.session.undo.len(), h.app.session.is_dirty()));
+}
