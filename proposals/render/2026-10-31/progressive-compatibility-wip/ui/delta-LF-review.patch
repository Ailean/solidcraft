+#[test]
+fn cpu_capture_cadence_is_absent_for_single_raster_gpu_and_present_for_derived_interactive_progressive() {
+    let mut h = Harness::new();
+    h.app.preferences.render_cpu_progressive_every_pass = false;
+    h.app.preferences.render_cpu_interactive_explicit_sampling = false;
+    h.app.render_workspace.view.draft.width = 16;
+    h.app.render_workspace.view.draft.height = 16;
+    for method in [ImageMethod::Raster, ImageMethod::GpuRaytrace, ImageMethod::CpuRaytrace] {
+        h.app.render_workspace.view.method = method;
+        h.app.render_workspace.view.raytrace.progressive = None;
+        let request = image_request(&h.app).unwrap();
+        assert!(request.get("cpu_progressive_every_pass").is_none());
+    }
+    h.app.render_workspace.view.raytrace.primary_samples = 16;
+    let fixed_editor = json!(h.app.render_workspace.view.raytrace);
+    let preview_request = interactive_request(&h.app).unwrap();
+    assert_eq!(preview_request["cpu_progressive_every_pass"], false);
+    assert!(preview_request["raytrace"].get("progressive").is_none(), "engine owns Fixed-to-Interactive conversion");
+    assert_eq!(preview_request["raytrace"]["primary_samples"], 16);
+    assert_eq!(json!(h.app.render_workspace.view.raytrace), fixed_editor);
+}
