+#[test]
+fn interactive_snapshot_policy_and_sampling_stay_captured_after_later_preference_edits() {
+    use solidcraft_engine::render::job::{CpuProgressiveOptions, Phase, interactive::VisualRevision};
+    use std::time::Duration;
+    let mut h = interactive_ui_fixture();
+    if !interactive_test_cpu_branch(&mut h, "interactive_snapshot_policy_and_sampling_stay_captured_after_later_preference_edits") {
+        return;
+    }
+    h.app.render_workspace.view.draft.width = 4;
+    h.app.render_workspace.view.draft.height = 4;
+    h.app.render_workspace.view.raytrace.primary_samples = 1;
+    h.app.render_workspace.view.raytrace.progressive = Some(CpuProgressiveOptions { samples_per_pixel: 5, seed: 741 });
+    h.app.preferences.render_cpu_progressive_every_pass = false;
+    h.app.preferences.render_cpu_interactive_explicit_sampling = false;
+    let captured_value = interactive_request(&h.app).unwrap();
+    let context = h.app.session.interactive_render().unwrap();
+    context.enable(VisualRevision { scene_generation: h.app.session.revision, visual_revision: 1 }, Duration::ZERO).unwrap();
+    let ticket = context.capture(Duration::from_millis(201)).unwrap().unwrap();
+    let snapshot = context.snapshot(&h.app.session, ticket, &captured_value).unwrap();
+    h.app.preferences.render_cpu_progressive_every_pass = true;
+    h.app.preferences.render_cpu_interactive_explicit_sampling = true;
+    assert_ne!(interactive_request(&h.app).unwrap(), captured_value);
+    assert!(snapshot.run().unwrap(), "the real snapshot prepares its frozen command Value");
+    let handle = context.current().unwrap().unwrap();
+    let status = handle.wait_timeout(Duration::from_secs(60)).unwrap();
+    assert_eq!(status.progress.phase, Phase::Completed, "{:?}", status.error);
+    assert!(!status.request.cpu_progressive_every_pass);
+    assert_eq!(status.request.raytrace.as_ref().unwrap().progressive, Some(CpuProgressiveOptions { samples_per_pixel: 16, seed: 0 }));
+    assert_eq!(serde_json::to_value(&status.request).unwrap()["cpu_progressive_every_pass"], false, "prepared metadata keeps the canonical false value");
+    assert!(handle.frame().unwrap().is_some());
+    assert_eq!(h.app.render_workspace.view.raytrace.progressive, Some(CpuProgressiveOptions { samples_per_pixel: 5, seed: 741 }));
+    interactive_assert_final_export_isolation(&mut h, &handle);
+    context.disable().unwrap();
+}
