+#[test]
+fn legacy_interactive_sampling_keeps_reduced_preview_admission_without_final_budget_or_hostile_repair() {
+    use solidcraft_engine::render::job::{CpuProgressiveOptions, ImageRequest, interactive::cpu_request};
+    let mut h = Harness::new();
+    h.app.render_workspace.view.method = ImageMethod::CpuRaytrace;
+    h.app.render_workspace.view.draft.width = 3840;
+    h.app.render_workspace.view.draft.height = 2160;
+    h.app.render_workspace.view.raytrace.primary_samples = 1;
+    h.app.render_workspace.view.raytrace.progressive = Some(CpuProgressiveOptions { samples_per_pixel: 31, seed: 741 });
+    h.app.preferences.render_cpu_progressive_every_pass = false;
+    h.app.preferences.render_cpu_interactive_explicit_sampling = false;
+    let editor = json!(h.app.render_workspace.view.raytrace);
+    assert!(image_request(&h.app).is_err(), "the original final dimensions still exceed Compact progressive admission");
+    let wire = interactive_request(&h.app).unwrap();
+    assert_eq!((wire["settings"]["width"].as_u64(), wire["settings"]["height"].as_u64()), (Some(3840), Some(2160)));
+    let request: ImageRequest = serde_json::from_value(json!({
+        "integrator":"raytrace", "camera":h.app.cam, "width":3840, "height":2160,
+        "background":h.app.render_workspace.view.draft.background, "transparent_background":false,
+        "raytrace":wire["raytrace"], "cpu_progressive_every_pass":wire["cpu_progressive_every_pass"]
+    })).unwrap();
+    let preview = cpu_request(&request).unwrap();
+    assert_eq!((preview.width, preview.height), (1024, 576));
+    assert!(!preview.cpu_progressive_every_pass, "the same canonical cadence flag survives derived capture");
+    assert_eq!(preview.raytrace.as_ref().unwrap().progressive, Some(CpuProgressiveOptions { samples_per_pixel: 16, seed: 0 }));
+    assert_eq!(json!(h.app.render_workspace.view.raytrace), editor);
+    h.app.preferences.render_cpu_interactive_explicit_sampling = true;
+    let explicit = interactive_request(&h.app).unwrap();
+    let mut explicit_request = request.clone();
+    explicit_request.raytrace = Some(serde_json::from_value(explicit["raytrace"].clone()).unwrap());
+    assert!(cpu_request(&explicit_request).is_err(), "31SPP exceeds the reduced image's original camera-sample envelope; never downgrade it");
+    h.app.preferences.render_cpu_interactive_explicit_sampling = false;
+    h.app.render_workspace.view.raytrace.progressive.as_mut().unwrap().samples_per_pixel = 0;
+    assert!(interactive_request(&h.app).is_err(), "legacy preview cannot repair an invalid numerical request");
+    assert_eq!(h.app.render_workspace.view.raytrace.progressive.unwrap().samples_per_pixel, 0);
+}
